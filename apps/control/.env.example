# -----------------------------------------------------------------------------
# @base/control 环境变量配置模板 (apps/control)
# 复制本文件为 .env.local 即可用于本地开发：
# cp apps/control/.env.example apps/control/.env.local
# -----------------------------------------------------------------------------

# 1. 平台总控库 (Control DB) 连接串
# 总控台管理系统用于管理租户注册、物理库配置与平台级超管认证
CONTROL_DATABASE_URL="postgresql://base_local:base_local_only@127.0.0.1:55433/saas_control?schema=public"

# 2. Better Auth 认证配置
# 密钥推荐使用 `openssl rand -base64 32` 生成，长度至少 32 字符
BETTER_AUTH_SECRET="base-control-local-dev-auth-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3001"

# 3. 控制平面超级管理员白名单（多个邮箱用英文逗号分隔）
# 默认系统超管为 admin@qq.com，可将开发成员/管理员邮箱追加到此处
CONTROL_ADMIN_EMAILS="admin@qq.com,348514929@qq.com"

# 4. Day 0 平台超管初始化（严格空库首次启动时必填）
# 邮箱应同时包含在 CONTROL_ADMIN_EMAILS 中；密码仅从 Secret/环境变量注入，禁止提交真实生产密码。
CONTROL_BOOTSTRAP_ADMIN_EMAIL="admin@qq.com"
CONTROL_BOOTSTRAP_ADMIN_NAME="平台超级管理员"
CONTROL_BOOTSTRAP_ADMIN_PASSWORD="ChangeThisLocalBootstrapPassword123!"

# 5. 基础服务端口与公网前缀 (可选)
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"
