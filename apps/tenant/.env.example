# -----------------------------------------------------------------------------
# @base/tenant 环境变量配置模板 (apps/tenant)
# 复制本文件为 .env.local 即可用于本地开发：
# cp apps/tenant/.env.example apps/tenant/.env.local
# -----------------------------------------------------------------------------

# 1. 平台总控库 (Control DB) 连接串
# 租户系统启动时需要连接 Control DB 解析租户元数据与物理库路由
CONTROL_DATABASE_URL="postgresql://base_local:base_local_only@127.0.0.1:55433/saas_control?schema=public"

# 2. Better Auth 认证配置
# 密钥推荐使用 `openssl rand -base64 32` 生成，长度至少 32 字符
BETTER_AUTH_SECRET="base-tenant-local-dev-auth-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# 3. 基础服务端口与公网前缀 (可选)
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. 外网穿透/跨域/局域网调试来源配置 (可选，多个用英文逗号分隔)
# 若使用特定 IP (如 100.83.215.28) 或自定义穿透域名调试时，在此处配置
ALLOWED_ORIGINS="100.83.215.28,*.yourdomain.com"

# 5. 对象存储配置 (S3 兼容协议：本地 MinIO / 线上阿里云 OSS / 腾讯云 COS / AWS S3)
# 启动本地 MinIO: docker compose -f docker-compose.storage.yml up -d
STORAGE_PROVIDER="minio"
STORAGE_REGION="us-east-1"
# 服务端调用 Endpoint (若是 Docker 容器间通信可写 http://minio:9000，本地宿主机写 http://127.0.0.1:9000)
STORAGE_ENDPOINT="http://127.0.0.1:9000"
# 前端直传与浏览器查看图片的公网/访问基准域名
STORAGE_PUBLIC_DOMAIN="http://127.0.0.1:9000"
STORAGE_BUCKET="chenrun-erp-local"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
# MinIO 必须设为 true (Path-Style)；阿里云 OSS / S3 设为 false (Virtual-Hosted)
STORAGE_FORCE_PATH_STYLE="true"

