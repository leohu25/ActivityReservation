# -----------------------------------------------------------------------------
# @base/tenant 环境变量配置模板 (apps/tenant)
# 复制本文件为 .env.local 即可用于本地开发：
# cp apps/tenant/.env.example apps/tenant/.env.local
# -----------------------------------------------------------------------------

# 1. 平台总控库 (Control DB) 连接串
# 租户系统启动时需要连接 Control DB 解析租户元数据与物理库路由
CONTROL_DATABASE_URL="postgresql://base_local:base_local_only@127.0.0.1:55433/saas_control?schema=public"

# 2. Better Auth 认证配置
# 密钥推荐使用 `openssl rand -base64 32` 生成，长度至少 32 字符
BETTER_AUTH_SECRET="base-tenant-local-dev-auth-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# 3. 基础服务端口与公网前缀 (可选)
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. 外网穿透/跨域/局域网调试来源配置 (可选，多个用英文逗号分隔)
# 若使用特定 IP (如 100.83.215.28) 或自定义穿透域名调试时，在此处配置
ALLOWED_ORIGINS="100.83.215.28,*.yourdomain.com"
