{
  "name": "next-saas-base",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "init": "./init.sh",
    "status": "./scripts/tools/status.sh",
    "verify": "./scripts/verify.sh",
    "session:end": "node .harness/lifecycle/session-end.mjs",
    "ui:add": "npx shadcn@latest add -y --overwrite -c packages/ui",
    "codegen": "node scripts/sync/sync-features.mjs && node scripts/sync/sync-tenant-schema.mjs",
    "sync:features": "pnpm codegen",
    "db:migrate:check": "pnpm --filter @base/db-migrate check",
    "db:migrate:catalog": "pnpm --filter @base/db-migrate exec tsx src/cli.ts catalog",
    "db:migrate:generate": "pnpm --filter @base/db-migrate exec tsx src/cli.ts generate",
    "db:migrate:baseline": "pnpm --filter @base/db-migrate exec tsx src/cli.ts baseline",
    "db:migrate:baseline:reset": "pnpm --filter @base/db-migrate exec tsx src/cli.ts baseline --scope tenant --reset",
    "db:platform:ensure": "pnpm --filter @base/db-migrate exec tsx src/cli.ts ensure-platform",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:control": "turbo run dev --filter=control",
    "dev:tenant": "turbo run dev --filter=tenant",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "db:control:diff": "pnpm --filter @base/db-control db:diff",
    "db:control:diff:sql": "pnpm --filter @base/db-control db:diff:sql",
    "db:control:push": "pnpm --filter @base/db-control db:push",
    "db:control:status": "pnpm --filter @base/db-control db:status",
    "db:control:gen": "pnpm --filter @base/db-control generate",
    "clean:cache": "rm -rf .turbo apps/*/.next"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
