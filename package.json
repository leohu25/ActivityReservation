{
  "name": "next-saas-base",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "// 1. 工程协同与门禁 (Harness & Gates)": "",
    "init": "node scripts/init.mjs",
    "status": "node scripts/tools/status.mjs",
    "verify": "node scripts/verify.mjs",
    "session:end": "node .harness/lifecycle/session-end.mjs",
    "ui:add": "npx shadcn@latest add -y --overwrite -c packages/base/ui",
    "// 2. Turborepo 核心拓扑 (全自动化调度)": "",
    "dev": "turbo run dev",
    "dev:control": "turbo run dev --filter=control",
    "dev:tenant": "turbo run dev --filter=tenant",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "// 3. 数据库迁移引擎 (发布与版本生成)": "",
    "db:platform:ensure": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts ensure-platform",
    "db:tenant:reset": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts reset-tenant",
    "db:migrate:generate": "pnpm --filter @tool/db-migrate migration:generate",
    "db:migrate:check": "pnpm --filter @tool/db-migrate check",
    "db:migrate:baseline": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts baseline",
    "db:migrate:baseline:reset:tenant": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts baseline --scope tenant --reset",
    "db:migrate:baseline:reset:platform": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts baseline --scope platform --reset",
    "// 4. 双端架构结构差异比对 (Diff 诊断预览，严禁直接无痕 Push)": "",
    "db:control:diff": "pnpm --filter @base/db-control db:diff",
    "db:control:diff:sql": "pnpm --filter @base/db-control db:diff:sql",
    "db:tenant:diff": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts diff --scope tenant",
    "db:tenant:diff:sql": "pnpm --filter @tool/db-migrate exec tsx src/cli.ts diff:sql --scope tenant",
    "// 5. 辅助与缓存清理": "",
    "clean:cache": "node scripts/clean.mjs",
    "// 6. 生产容器构建与部署 (Docker)": "",
    "docker:build": "node scripts/docker/build-images.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
