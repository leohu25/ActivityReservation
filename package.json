{
  "name": "chenrun-erp-nextjs",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "init": "./init.sh",
    "status": "./scripts/status.sh",
    "verify": "./scripts/verify.sh",
    "session:end": "./scripts/session-end.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "migrate": "pnpm --filter @chenrun/tenant-migrate migrate",
    "migrate:gen": "pnpm --filter @chenrun/tenant-migrate migrate generate",
    "migrate:up": "pnpm --filter @chenrun/tenant-migrate migrate up",
    "migrate:status": "pnpm --filter @chenrun/tenant-migrate migrate status",
    "migrate:retry": "pnpm --filter @chenrun/tenant-migrate migrate retry"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
