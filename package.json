{
  "name": "chenrun-erp-nextjs",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "init": "./init.sh",
    "status": "./scripts/status.sh",
    "verify": "./scripts/verify.sh",
    "session:end": "./scripts/session-end.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:control": "pnpm --filter control dev",
    "dev:tenant": "pnpm --filter tenant dev",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "migrate": "pnpm --filter @chenrun/tenant-migrate migrate",
    "migrate:gen": "pnpm --filter @chenrun/tenant-migrate migrate generate",
    "migrate:up": "pnpm --filter @chenrun/tenant-migrate migrate up --all",
    "migrate:status": "pnpm --filter @chenrun/tenant-migrate migrate status",
    "migrate:retry": "pnpm --filter @chenrun/tenant-migrate migrate retry",
    "db:control:diff": "pnpm --filter @chenrun/db-control db:diff",
    "db:control:diff:sql": "pnpm --filter @chenrun/db-control db:diff:sql",
    "db:control:push": "pnpm --filter @chenrun/db-control db:push",
    "db:control:status": "pnpm --filter @chenrun/db-control db:status",
    "db:control:gen": "pnpm --filter @chenrun/db-control generate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
