{
  "name": "chenrun-erp-nextjs",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "init": "./init.sh",
    "status": "./scripts/status.sh",
    "verify": "./scripts/verify.sh",
    "session:end": "./scripts/session-end.sh",
    "ui:add": "npx shadcn@latest add -y --overwrite -c packages/ui",
    "sync:features": "node scripts/sync-features.mjs",
    "build": "pnpm sync:features && turbo run build",
    "dev": "pnpm sync:features && turbo run dev",
    "dev:control": "pnpm --filter control dev",
    "dev:tenant": "pnpm --filter tenant dev",
    "lint": "turbo run lint",
    "check": "pnpm sync:features && turbo run check",
    "test": "pnpm sync:features && turbo run test",
    "migrate:platform": "pnpm --filter @chenrun/platform-migrate migrate",
    "migrate:platform:up": "pnpm --filter @chenrun/platform-migrate migrate up",
    "migrate:platform:status": "pnpm --filter @chenrun/platform-migrate migrate status",
    "migrate:platform:down": "pnpm --filter @chenrun/platform-migrate migrate down",
    "migrate:tenant": "pnpm --filter @chenrun/tenant-migrate migrate",
    "migrate:tenant:gen": "pnpm --filter @chenrun/tenant-migrate migrate generate",
    "migrate:tenant:up": "pnpm --filter @chenrun/tenant-migrate migrate up --all",
    "migrate:tenant:status": "pnpm --filter @chenrun/tenant-migrate migrate status",
    "migrate:tenant:down": "pnpm --filter @chenrun/tenant-migrate migrate down",
    "migrate:tenant:retry": "pnpm --filter @chenrun/tenant-migrate migrate retry",
    "migrate": "pnpm run migrate:tenant",
    "migrate:gen": "pnpm run migrate:tenant:gen",
    "migrate:up": "pnpm run migrate:tenant:up",
    "migrate:status": "pnpm run migrate:tenant:status",
    "migrate:retry": "pnpm run migrate:tenant:retry",
    "db:control:diff": "pnpm --filter @chenrun/db-control db:diff",
    "db:control:diff:sql": "pnpm --filter @chenrun/db-control db:diff:sql",
    "db:control:push": "pnpm --filter @chenrun/db-control db:push",
    "db:control:status": "pnpm --filter @chenrun/db-control db:status",
    "db:control:gen": "pnpm --filter @chenrun/db-control generate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
