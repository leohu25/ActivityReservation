// 租户独立物理数据库 Schema (Database-per-Tenant)
// 包含租户内部的基础组织与系统配置模型 (部门、岗位、员工档案等)
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

/// 部门拓扑模型 (用于数据范围 DEPT / DEPT_TREE 判定)
model Department {
  /// 部门主键ID (UUIDv7)
  id             String   @id @default(uuid(7)) @db.Uuid
  /// 部门名称
  name           String
  /// 部门业务编码
  code           String   @unique
  /// 父级部门ID (支持树状拓扑)
  parentId       String?  @map("parent_id") @db.Uuid
  /// 部门分管领导/主管成员ID (关联平台 Member.id)
  leaderMemberId String?  @map("leader_member_id")
  /// 显示排序权重 (数字越小越靠前)
  sort           Int      @default(0)
  /// 部门状态: ACTIVE(正常) / DISABLED(停用)
  status         String   @default("ACTIVE")
  /// 创建时间
  createdAt      DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime @updatedAt @map("updated_at")

  employees      EmployeeProfile[]

  @@index([parentId])
  @@index([status])
  @@map("department")
}

/// 岗位模型 (实现 Position != Role 物理正交解耦)
model Position {
  /// 岗位主键ID
  id          String            @id @default(uuid(7)) @db.Uuid
  /// 岗位名称
  name        String
  /// 岗位业务编码
  code        String            @unique
  /// 岗位职责详细描述
  description String?
  /// 排序权重 (数字越小越靠前)
  sort        Int               @default(0)
  /// 岗位状态: ACTIVE(正常) / DISABLED(停用)
  status      String            @default("ACTIVE")
  /// 创建时间
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime          @updatedAt @map("updated_at")

  employees   EmployeeProfile[]

  @@index([status])
  @@map("position")
}

/// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  /// 员工档案主键ID
  id                String           @id @default(uuid(7)) @db.Uuid
  /// 关联平台租户成员主键 (Control DB Member.id)
  memberId          String?          @unique @map("member_id")
  /// 关联平台用户账号ID (Control DB User.id)
  userId            String?          @map("user_id")
  /// 邀请记录ID (关联邀请审核流)
  invitationId      String?          @map("invitation_id")
  /// 员工工号 (企业内部唯一)
  employeeNo        String?          @unique @map("employee_no")
  /// 所属部门主键ID
  departmentId      String?          @map("department_id") @db.Uuid
  /// 所属岗位主键ID
  positionId        String?          @map("position_id") @db.Uuid
  /// 直属上级经理档案ID
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  /// 员工姓名
  name              String           @default("") @map("name")
  /// 员工工作邮箱
  email             String           @default("") @map("email")
  /// 员工手机号
  phone             String?          @map("phone")
  /// 职务头衔/对外称谓
  jobTitle          String?          @map("job_title")
  /// 员工头像/工牌照 URL
  avatarUrl         String?          @map("avatar_url")
  /// 员工在职状态: ACTIVE(在职) / TERMINATED(离职) / SUSPENDED(停职)
  status            String           @default("ACTIVE")
  /// 入职报到时间
  joinedAt          DateTime?        @map("joined_at")
  /// 离职归档时间
  terminatedAt      DateTime?        @map("terminated_at")
  /// 档案创建时间
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 档案最后更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at")

  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  manager           EmployeeProfile? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subordinates      EmployeeProfile[] @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([memberId])
  @@index([status])
  @@map("employee_profile")
}

/// 租户企业扩展资料模型 (与平台 Organization 动静分离)
model CompanyProfile {
  /// 企业扩展资料主键ID
  id           String   @id @default(uuid(7)) @db.Uuid
  /// 企业主体注册全称
  companyName  String   @map("company_name")
  /// 企业简称/品牌名
  shortName    String?  @map("short_name")
  /// 统一社会信用代码
  creditCode   String?  @map("credit_code")
  /// 法定代表人姓名
  legalPerson  String?  @map("legal_person")
  /// 官方业务联系电话
  contactPhone String?  @map("contact_phone")
  /// 官方业务联系邮箱
  contactEmail String?  @map("contact_email")
  /// 经营办公/注册地址
  address      String?
  /// 业务时区 (默认 Asia/Shanghai)
  timezone     String   @default("Asia/Shanghai")
  /// 结算本位币种 (默认 CNY)
  currency     String   @default("CNY")
  /// 记录创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 记录更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

/// 租户动态导航菜单配置模型 (支持现场层级调整、自定义别名与跨切片灵活编排)
model TenantMenuItem {
  /// 节点主键ID
  id           String    @id @default(uuid(7)) @db.Uuid
  /// 父节点ID (空表示顶级大菜单/顶级单页)
  parentId     String?   @map("parent_id") @db.Uuid
  /// 节点类型: GROUP(大菜单/目录分组) | PAGE(具体功能页面) | LINK(外部链接)
  itemType     String    @default("PAGE") @map("item_type")
  /// 关联的标准页面键名 (若 itemType="PAGE"，对应 StandardPageDescriptor.pageKey)
  pageKey      String?   @map("page_key")
  /// 外部跳转 URL (若 itemType="LINK"，如 "https://bi.company.com")
  externalUrl  String?   @map("external_url")
  /// 是否在新标签页打开
  openInNewTab Boolean   @default(false) @map("open_in_new_tab")
  /// 自定义显示别名 (现场实施重命名；空则使用页面契约 defaultLabel)
  customLabel  String?   @map("custom_label")
  /// 自定义图标名称 (空则使用页面契约 defaultIcon)
  customIcon   String?   @map("custom_icon")
  /// 排序权重 (升序排列)
  sortOrder    Int       @default(0) @map("sort_order")
  /// 是否可见
  isVisible    Boolean   @default(true) @map("is_visible")

  /// 创建人 ID (UUIDv7，系统写入为 SYSTEM_ACTOR_ID)
  createdById  String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (UUIDv7)
  deptId       String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (UUIDv7)
  updatedById  String?   @map("updated_by_id") @db.Uuid
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// 软删除标记
  isDeleted    Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt    DateTime? @map("deleted_at")
  /// 软删除人 ID (UUIDv7)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  @@index([parentId, sortOrder])
  @@index([isDeleted])
  @@map("tenant_menu_item")
}

/// 通用业务附件元数据模型 (Tenant DB 物理隔离，严格对齐 ADR-009 实体审计基线)
model Attachment {
  /// 附件主键ID
  id          String    @id @default(uuid(7)) @db.Uuid
  /// 归属业务模块 (如 employee, customer, item 等)
  module      String    @db.VarChar(50)
  /// 关联业务实体主键ID (如员工档案ID、客户ID)
  targetId    String?   @map("target_id") @db.VarChar(64)
  /// 业务字段标识 (如 avatar, id_card, attachment 等)
  fieldKey    String?   @map("field_key") @db.VarChar(50)
  /// 原始文件名
  fileName    String    @map("file_name") @db.VarChar(255)
  /// 对象存储内部 Key
  storageKey  String    @map("storage_key") @db.VarChar(500)
  /// 访问 URL
  fileUrl     String    @map("file_url") @db.VarChar(1000)
  /// 文件大小 (字节)
  fileSize    BigInt    @map("file_size")
  /// MIME 类型
  mimeType    String    @map("mime_type") @db.VarChar(100)

  /// 创建人 ID (必填，审计基线，UUIDv7)
  createdById String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (选填，支持部门数据范围权限过滤，UUIDv7)
  deptId      String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (选填，UUIDv7)
  updatedById String?   @map("updated_by_id") @db.Uuid
  /// 创建时间 (必填)
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间 (必填)
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// 软删除标记 (必填)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  /// 软删除时间 (选填)
  deletedAt   DateTime? @map("deleted_at")
  /// 软删除人 ID (选填，UUIDv7)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([targetId, module])
  @@index([createdById])
  @@map("attachment")
}
