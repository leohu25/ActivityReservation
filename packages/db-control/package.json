{
  "name": "@base/db-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "control-migrate": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "generate": "prisma generate --config prisma.config.ts",
    "db:diff": "tsx src/cli.ts diff",
    "db:diff:sql": "tsx src/cli.ts diff:sql",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "test": "tsx --test --test-reporter=../../scripts/reporter/fail-only-reporter.mjs src/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  }
}
