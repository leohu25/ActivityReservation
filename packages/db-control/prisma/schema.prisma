// Control DB client used by Better Auth and tenant routing.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[] @relation("InvitationInviter")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                   String          @id
  name                 String
  slug                 String          @unique
  logo                 String?
  createdAt            DateTime        @default(now()) @map("created_at")
  metadata             String?
  authorizationVersion Int             @default(1) @map("authorization_version")
  members              Member[]
  invitations          Invitation[]
  roles                OrganizationRole[]
  tenantDatabase       TenantDatabase?
  migrations           TenantMigration[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model OrganizationRole {
  id             String       @id
  organizationId String       @map("organization_id")
  role           String
  permission     String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([role])
  @@map("organization_role")
}

model TenantDatabase {
  id             String               @id @default(cuid())
  organizationId String               @unique @map("organization_id")
  clusterCode    String               @map("cluster_code")
  databaseName   String               @map("database_name")
  secretRef      String               @map("secret_ref")
  schemaVersion  String               @map("schema_version")
  status         TenantDatabaseStatus @default(PROVISIONING)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clusterCode, status])
  @@map("tenant_database")
}

enum TenantDatabaseStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

enum TenantMigrationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

model TenantMigration {
  id              String                @id @default(cuid())
  organizationId  String                @map("organization_id")
  migrationName   String                @map("migration_name")
  version         String
  batchId         String?               @map("batch_id")
  status          TenantMigrationStatus @default(PENDING)
  appliedSteps    Int                   @default(0) @map("applied_steps")
  errorMessage    String?               @map("error_message")
  executionTimeMs Int?                  @map("execution_time_ms")
  startedAt       DateTime?             @map("started_at")
  finishedAt      DateTime?             @map("finished_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([batchId])
  @@index([organizationId, version])
  @@map("tenant_migration")
}
