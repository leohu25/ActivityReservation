// 租户独立物理数据库 Schema (Database-per-Tenant)
// 包含租户内部的基础组织与系统配置模型 (部门、岗位、员工档案等)
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}

datasource db {
  provider = "postgresql"
}

/// 部门拓扑模型 (用于数据范围 DEPT / DEPT_TREE 判定)
model Department {
  /// 部门主键ID (UUID/CUID)
  id             String   @id
  /// 部门名称
  name           String
  /// 部门业务编码
  code           String   @unique
  /// 父级部门ID (支持树状拓扑)
  parentId       String?  @map("parent_id")
  /// 部门分管领导/主管成员ID (关联平台 Member.id)
  leaderMemberId String?  @map("leader_member_id")
  /// 显示排序权重 (数字越小越靠前)
  sort           Int      @default(0)
  /// 部门状态: ACTIVE(正常) / DISABLED(停用)
  status         String   @default("ACTIVE")
  /// 创建时间
  createdAt      DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime @updatedAt @map("updated_at")

  employees      EmployeeProfile[]

  @@index([parentId])
  @@index([status])
  @@map("department")
}

/// 岗位模型 (实现 Position != Role 物理正交解耦)
model Position {
  /// 岗位主键ID
  id          String            @id @default(cuid())
  /// 岗位名称
  name        String
  /// 岗位业务编码
  code        String            @unique
  /// 岗位职责详细描述
  description String?
  /// 排序权重 (数字越小越靠前)
  sort        Int               @default(0)
  /// 岗位状态: ACTIVE(正常) / DISABLED(停用)
  status      String            @default("ACTIVE")
  /// 创建时间
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime          @updatedAt @map("updated_at")

  employees   EmployeeProfile[]

  @@index([status])
  @@map("position")
}

/// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  /// 员工档案主键ID
  id                String           @id @default(cuid())
  /// 关联平台租户成员主键 (Control DB Member.id)
  memberId          String?          @unique @map("member_id")
  /// 关联平台用户账号ID (Control DB User.id)
  userId            String?          @map("user_id")
  /// 邀请记录ID (关联邀请审核流)
  invitationId      String?          @map("invitation_id")
  /// 员工工号 (企业内部唯一)
  employeeNo        String?          @unique @map("employee_no")
  /// 所属部门主键ID
  departmentId      String?          @map("department_id")
  /// 所属岗位主键ID
  positionId        String?          @map("position_id")
  /// 直属上级经理档案ID
  managerEmployeeId String?          @map("manager_employee_id")
  /// 员工姓名快照 (冗余展示与防变更穿透)
  nameSnapshot      String           @default("") @map("name_snapshot")
  /// 员工工作邮箱快照
  emailSnapshot     String           @default("") @map("email_snapshot")
  /// 职务头衔/对外称谓
  jobTitle          String?          @map("job_title")
  /// 员工在职状态: ACTIVE(在职) / TERMINATED(离职) / SUSPENDED(停职)
  status            String           @default("ACTIVE")
  /// 入职报到时间
  joinedAt          DateTime?        @map("joined_at")
  /// 离职归档时间
  terminatedAt      DateTime?        @map("terminated_at")
  /// 档案创建时间
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 档案最后更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at")

  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager           EmployeeProfile? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  subordinates      EmployeeProfile[] @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([memberId])
  @@index([status])
  @@map("employee_profile")
}

/// 租户企业扩展资料模型 (与平台 Organization 动静分离)
model CompanyProfile {
  /// 企业扩展资料主键ID
  id           String   @id @default(cuid())
  /// 企业主体注册全称
  companyName  String   @map("company_name")
  /// 企业简称/品牌名
  shortName    String?  @map("short_name")
  /// 统一社会信用代码
  creditCode   String?  @map("credit_code")
  /// 法定代表人姓名
  legalPerson  String?  @map("legal_person")
  /// 官方业务联系电话
  contactPhone String?  @map("contact_phone")
  /// 官方业务联系邮箱
  contactEmail String?  @map("contact_email")
  /// 经营办公/注册地址
  address      String?
  /// 业务时区 (默认 Asia/Shanghai)
  timezone     String   @default("Asia/Shanghai")
  /// 结算本位币种 (默认 CNY)
  currency     String   @default("CNY")
  /// 记录创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 记录更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}
