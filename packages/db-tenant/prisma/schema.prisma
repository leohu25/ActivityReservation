// 租户独立物理数据库 Schema (Database-per-Tenant)
// 包含租户内部的业务实体模型（如采购订单、部门等）
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-tenant"
}

datasource db {
  provider = "postgresql"
}

// 部门拓扑模型 (用于数据范围 DEPT / DEPT_TREE 判定)
model Department {
  id        String   @id
  name      String
  code      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    PurchaseOrder[]
  employees EmployeeProfile[]

  @@index([parentId])
  @@map("department")
}

// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  id           String      @id @default(cuid())
  memberId     String      @unique
  departmentId String?
  employeeNo   String?     @unique
  jobTitle     String?
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([memberId])
  @@map("employee_profile")
}

// 采购订单业务模型 (核心 ERP 业务切片与 CASL 授权实体)
model PurchaseOrder {
  id           String      @id @default(cuid())
  orderNo      String      @unique
  supplierName String
  quantity     Int
  costPrice    Decimal     @db.Decimal(12, 2)
  deptId       String
  createdById  String
  status       String      @default("PENDING")
  auditComment String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department  @relation(fields: [deptId], references: [id], onDelete: Restrict)

  @@index([deptId])
  @@index([createdById])
  @@index([status])
  @@map("purchase_order")
}
