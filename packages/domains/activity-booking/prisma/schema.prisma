datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

/// ==============================================================================
/// 宁卫活动预约系统 - 业务数据模型 (遵循 ADR-009 实体审计与数据范围基线)
/// ==============================================================================

/// 场馆档案表 (Venues)
model Venue {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  address     String?  @db.VarChar(255)
  openTime    String?  @map("open_time") @db.VarChar(100)
  contactPhone String? @map("contact_phone") @db.VarChar(50)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(20)
  isDefault   Boolean  @default(false) @map("is_default")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  spaces      Space[]
  activities  Activity[]
  news        News[]

  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("venue")
}

/// 场所空间表 (Spaces)
model Space {
  id          String   @id @default(uuid(7)) @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  capacity    Int      @default(50)
  status      String   @default("ACTIVE") @db.VarChar(20)
  description String?  @db.VarChar(255)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue    @relation(fields: [venueId], references: [id])
  sessions    ActivitySession[]

  @@index([venueId])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("space")
}

/// 首页轮播图表 (Banner)
model Banner {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String   @db.VarChar(100)
  imageUrl    String   @map("image_url") @db.VarChar(500)
  linkUrl     String?  @map("link_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("ACTIVE") @db.VarChar(20)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("banner")
}

/// 场馆动态与新闻发布表 (News)
model News {
  id          String   @id @default(uuid(7)) @db.Uuid
  venueId     String?  @map("venue_id") @db.Uuid
  title       String   @db.VarChar(200)
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  summary     String?  @db.VarChar(300)
  content     String   @db.Text
  author      String?  @db.VarChar(100)
  viewsCount  Int      @default(0) @map("views_count")
  isTop       Boolean  @default(false) @map("is_top")
  status      String   @default("PUBLISHED") @db.VarChar(20)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue?   @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("news")
}

/// 活动表 (Activity)
model Activity {
  id          String   @id @default(uuid(7)) @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  title       String   @db.VarChar(150)
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  description String?  @db.Text
  type        String   @default("GENERAL") @db.VarChar(30)
  auditMode   String   @default("MANUAL") @map("audit_mode") @db.VarChar(20)
  allowTeam   Boolean  @default(true) @map("allow_team")
  minTeamSize Int      @default(5) @map("min_team_size")
  maxTeamSize Int      @default(50) @map("max_team_size")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("PUBLISHED") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue    @relation(fields: [venueId], references: [id])
  sessions    ActivitySession[]
  appointments Appointment[]
  volunteers  VolunteerApplication[]

  @@index([venueId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([deptId])
  @@index([isDeleted])
  @@map("activity")
}

/// 活动排班场次表 (ActivitySession)
model ActivitySession {
  id          String   @id @default(uuid(7)) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  spaceId     String?  @map("space_id") @db.Uuid
  date        String   @db.VarChar(20)
  startTime   String   @map("start_time") @db.VarChar(10)
  endTime     String   @map("end_time") @db.VarChar(10)
  totalCapacity Int    @default(50) @map("total_capacity")
  bookedCount Int      @default(0) @map("booked_count")
  lecturerId  String?  @map("lecturer_id") @db.Uuid
  status      String   @default("ACTIVE") @db.VarChar(20)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])
  space       Space?   @relation(fields: [spaceId], references: [id])
  appointments Appointment[]

  @@index([activityId])
  @@index([date, startTime])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("activity_session")
}

/// 预约申请单主表 (Appointment)
model Appointment {
  id            String   @id @default(uuid(7)) @db.Uuid
  code          String   @unique @db.VarChar(50)
  activityId    String   @map("activity_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  type          String   @default("INDIVIDUAL") @db.VarChar(20)
  applicantName String   @map("applicant_name") @db.VarChar(100)
  phone         String   @db.VarChar(50)
  idCard        String?  @map("id_card") @db.VarChar(50)
  organization  String?  @db.VarChar(150)
  peopleCount   Int      @default(1) @map("people_count")
  status        String   @default("PENDING") @db.VarChar(20)
  auditRemark   String?  @map("audit_remark") @db.VarChar(255)
  auditedById   String?  @map("audited_by_id") @db.Uuid
  auditedAt     DateTime? @map("audited_at")
  qrCodeSign    String?  @map("qr_code_sign") @db.VarChar(255)
  checkedInAt   DateTime? @map("checked_in_at")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])
  session     ActivitySession @relation(fields: [sessionId], references: [id])
  visitors    AppointmentVisitor[]
  team        AppointmentTeam?

  @@index([activityId])
  @@index([sessionId])
  @@index([phone])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("appointment")
}

/// 预约同行人/访客明细表 (AppointmentVisitor)
model AppointmentVisitor {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  name          String   @db.VarChar(100)
  phone         String?  @db.VarChar(50)
  idCard        String?  @map("id_card") @db.VarChar(50)
  isLeader      Boolean  @default(false) @map("is_leader")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([deptId])
  @@index([isDeleted])
  @@map("appointment_visitor")
}

/// 团队预约扩展信息表 (AppointmentTeam)
model AppointmentTeam {
  id            String   @id @default(uuid(7)) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  teamName      String   @map("team_name") @db.VarChar(150)
  inviteCode    String   @unique @map("invite_code") @db.VarChar(20)
  leaderName    String   @map("leader_name") @db.VarChar(100)
  leaderPhone   String   @map("leader_phone") @db.VarChar(50)
  contactEmail  String?  @map("contact_email") @db.VarChar(100)
  targetCount   Int      @default(10) @map("target_count")
  joinedCount   Int      @default(1) @map("joined_count")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
  @@index([deptId])
  @@index([isDeleted])
  @@map("appointment_team")
}

/// 志愿者申请表 (VolunteerApplication)
model VolunteerApplication {
  id          String   @id @default(uuid(7)) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(50)
  studentNo   String?  @map("student_no") @db.VarChar(50)
  major       String?  @db.VarChar(100)
  serviceRole String?  @map("service_role") @db.VarChar(50)
  status      String   @default("PENDING") @db.VarChar(20)
  auditRemark String?  @map("audit_remark") @db.VarChar(255)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])

  @@index([activityId])
  @@index([phone])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("volunteer_application")
}

/// 教职工与学生组织主数据同步表 (CampusSyncRecord)
model CampusSyncRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  type        String   @db.VarChar(20)
  userCode    String   @map("user_code") @db.VarChar(50)
  name        String   @db.VarChar(100)
  department  String?  @db.VarChar(150)
  className   String?  @map("class_name") @db.VarChar(100)
  idCard      String?  @map("id_card") @db.VarChar(50)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(100)
  syncStatus  String   @default("PENDING") @map("sync_status") @db.VarChar(20)
  errorMsg    String?  @map("error_msg") @db.VarChar(500)
  boundUserId String?  @map("bound_user_id") @db.Uuid

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, userCode])
  @@index([type, syncStatus])
  @@index([deptId])
  @@index([isDeleted])
  @@map("campus_sync_record")
}
