generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-base-archives"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

/// 租户业务基础档案数据字典项表 (租户全域共享配置字典，通过 status 启停用)
model TenantDictItem {
  /// 字典项主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 字典类型编码 (as const 枚举分类，例如 CUSTOMER_LEVEL)
  type        String   @map("type") @db.VarChar(50)
  /// 字典项业务编码 (同一 type 下唯一)
  code        String   @map("code") @db.VarChar(50)
  /// 字典项显示名称
  name        String   @map("name") @db.VarChar(100)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @map("status") @db.VarChar(10)
  /// 显示排序权重 (数字越小越靠前)
  sort        Int      @default(0) @map("sort")
  /// 是否默认选中项
  isDefault   Boolean  @default(false) @map("is_default")
  /// 备注说明
  remark      String?  @map("remark") @db.VarChar(255)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, status])
  @@index([status])
  @@map("tenant_dict_item")
}
