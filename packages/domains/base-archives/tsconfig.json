{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@/components/ui/*": ["../../base/ui/src/components/ui/*"],
			"@/hooks/*": ["../../base/ui/src/hooks/*"],
			"@base/ui": ["../../base/ui/src/index.ts"],
			"@base/ui/*": ["../../base/ui/src/*"]
		}
	},
	"include": ["src/**/*", "prisma/**/*"],
	"exclude": ["node_modules"]
}
