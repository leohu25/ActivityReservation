generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-production-center"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ==========================================
// 1. 生产资源 (production-resource-management)
// ==========================================

/// 生产车间主档表
model Workshop {
  /// 主键ID (UUIDv7)
  id              String           @id @default(uuid(7)) @db.Uuid
  /// 车间编码 (全表唯一)
  code            String           @unique @map("code") @db.VarChar(64)
  /// 车间名称
  name            String           @map("name") @db.VarChar(128)
  /// 车间说明/描述
  description     String?          @map("description") @db.Text
  /// 状态: ACTIVE / DISABLED
  status          String           @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById     String           @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId          String?          @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById     String?          @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted       Boolean          @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime?        @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById     String?          @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt       DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime         @updatedAt @map("updated_at")

  productionLines ProductionLine[]

  @@index([status])
  @@map("workshop")
}

/// 生产产线主档表
model ProductionLine {
  /// 主键ID (UUIDv7)
  id                   String                    @id @default(uuid(7)) @db.Uuid
  /// 所属车间ID
  workshopId           String                    @map("workshop_id") @db.Uuid
  /// 产线编码 (全表唯一)
  code                 String                    @unique @map("code") @db.VarChar(64)
  /// 产线名称
  name                 String                    @map("name") @db.VarChar(128)
  /// 产线通用最小生产批量默认值
  minimumBatchQuantity Decimal?                  @map("minimum_batch_quantity") @db.Decimal(20, 6)
  /// 最小批量单位ID (关联 UnitOfMeasure.id)
  minimumBatchUnitId   String?                   @map("minimum_batch_unit_id") @db.Uuid
  /// 状态: ACTIVE / DISABLED
  status               String                    @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById          String                    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId               String?                   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById          String?                   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted            Boolean                   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt            DateTime?                 @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById          String?                   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt            DateTime                  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  workshop             Workshop                  @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lineWarehouses       ProductionLineWarehouse[]
  lineOperations       ProductionLineOperation[]
  bomVersions          BomVersion[]

  @@index([workshopId, status])
  @@index([status])
  @@map("production_line")
}

/// 产线仓库关系表 (进料/在制品/出产/退料仓)
model ProductionLineWarehouse {
  /// 主键ID (UUIDv7)
  id               String         @id @default(uuid(7)) @db.Uuid
  /// 生产产线ID
  productionLineId String         @map("production_line_id") @db.Uuid
  /// 仓库ID (关联 Warehouse.id)
  warehouseId      String         @map("warehouse_id") @db.Uuid
  /// 仓库业务角色: INPUT(进料) / WIP(线边/在制品) / OUTPUT(成品产出) / RETURN(退料)
  warehouseRole    String         @map("warehouse_role") @db.VarChar(24)
  /// 是否为该角色的默认仓库
  isDefault        Boolean        @default(false) @map("is_default")

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById      String         @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId           String?        @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById      String?        @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted        Boolean        @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt        DateTime?      @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById      String?        @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime       @updatedAt @map("updated_at")

  productionLine   ProductionLine @relation(fields: [productionLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productionLineId, warehouseId, warehouseRole])
  @@index([productionLineId, warehouseRole])
  @@index([warehouseId])
  @@map("production_line_warehouse")
}

// ==========================================
// 2. 工艺资料 (process-management)
// ==========================================

/// 工序主档表
model Operation {
  /// 主键ID (UUIDv7)
  id                          String                    @id @default(uuid(7)) @db.Uuid
  /// 工序编码 (全表唯一)
  code                        String                    @unique @map("code") @db.VarChar(64)
  /// 工序名称
  name                        String                    @map("name") @db.VarChar(128)
  /// 工序分类字典项ID (OPERATION_CATEGORY)
  operationCategoryDictItemId String                    @map("operation_category_dict_item_id") @db.Uuid
  /// 默认准备时间 (分钟)
  defaultSetupMinutes         Int                       @default(0) @map("default_setup_minutes")
  /// 默认清理时间 (分钟)
  defaultCleanupMinutes       Int                       @default(0) @map("default_cleanup_minutes")
  /// 默认参考出成率 (不直接参与发布BOM计算)
  defaultYieldRate            Decimal?                  @map("default_yield_rate") @db.Decimal(12, 8)
  /// 最少操作人数
  minimumOperatorCount        Int?                      @map("minimum_operator_count")
  /// 工序默认最小批量
  minimumBatchQuantity        Decimal?                  @map("minimum_batch_quantity") @db.Decimal(20, 6)
  /// 最小批量单位ID (关联 UnitOfMeasure.id)
  minimumBatchUnitId          String?                   @map("minimum_batch_unit_id") @db.Uuid
  /// 默认 SOP 操作说明
  sopText                     String?                   @map("sop_text") @db.Text
  /// 状态: ACTIVE / DISABLED
  status                      String                    @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById                 String                    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                      String?                   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById                 String?                   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                   Boolean                   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                   DateTime?                 @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById                 String?                   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                   DateTime                  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                   DateTime                  @updatedAt @map("updated_at")

  specifications              ProcessingSpecification[]
  lineOperations              ProductionLineOperation[]
  bomVersionOperations        BomVersionOperation[]

  @@index([operationCategoryDictItemId, status])
  @@index([status])
  @@map("operation")
}

/// 加工规格表
model ProcessingSpecification {
  /// 主键ID (UUIDv7)
  id                   String                @id @default(uuid(7)) @db.Uuid
  /// 所属工序ID
  operationId          String                @map("operation_id") @db.Uuid
  /// 工序内规格编码 (如 CUT_SLICE_3MM)
  code                 String                @map("code") @db.VarChar(64)
  /// 规格名称 (如 切丝5mm、切片3mm)
  name                 String                @map("name") @db.VarChar(128)
  /// 加工说明
  description          String?               @map("description") @db.Text
  /// 默认参考出成率
  defaultYieldRate     Decimal?              @map("default_yield_rate") @db.Decimal(12, 8)
  /// 状态: ACTIVE / DISABLED
  status               String                @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById          String                @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId               String?               @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById          String?               @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted            Boolean               @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt            DateTime?             @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById          String?               @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt            DateTime              @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime              @updatedAt @map("updated_at")

  operation            Operation             @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bomVersionOperations BomVersionOperation[]

  @@unique([operationId, code])
  @@index([operationId, status])
  @@index([status])
  @@map("processing_specification")
}

/// 产线可用工序关系表
model ProductionLineOperation {
  /// 主键ID (UUIDv7)
  id               String         @id @default(uuid(7)) @db.Uuid
  /// 产线ID
  productionLineId String         @map("production_line_id") @db.Uuid
  /// 工序ID
  operationId      String         @map("operation_id") @db.Uuid
  /// 是否为该工序默认产线
  isDefault        Boolean        @default(false) @map("is_default")
  /// 本产线覆盖准备时间 (分钟)
  setupMinutes     Int?           @map("setup_minutes")
  /// 本产线覆盖清理时间 (分钟)
  cleanupMinutes   Int?           @map("cleanup_minutes")

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById      String         @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId           String?        @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById      String?        @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted        Boolean        @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt        DateTime?      @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById      String?        @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime       @updatedAt @map("updated_at")

  productionLine   ProductionLine @relation(fields: [productionLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation        Operation      @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productionLineId, operationId])
  @@index([operationId])
  @@map("production_line_operation")
}

// ==========================================
// 3. BOM 中心 (bom-management)
// ==========================================

/// BOM 版本族身份表 (同一套生产方案的稳定容器)
model Bom {
  /// 主键ID (UUIDv7，稳定版本族身份)
  id                        String              @id @default(uuid(7)) @db.Uuid
  /// 当前发布生效的 BOM 版本ID
  currentPublishedVersionId String?             @unique @map("current_published_version_id") @db.Uuid
  /// 版本族生命周期状态: ACTIVE(正常) / ARCHIVED(已归档)
  lifecycleStatus           String              @default("ACTIVE") @map("lifecycle_status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById               String              @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                    String?             @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById               String?             @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                 Boolean             @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                 DateTime?           @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById               String?             @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                 DateTime            @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  versions                  BomVersion[]        @relation("BomToVersions")
  currentPublishedVersion   BomVersion?         @relation("BomCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultBoms               ProductDefaultBom[]
  inputChildren             BomVersionInput[]   @relation("BomInputChildScheme")

  @@index([lifecycleStatus, isDeleted])
  @@index([deptId])
  @@map("bom")
}

/// BOM 完整版本表 (发布后不可变的生产方案快照)
model BomVersion {
  /// 主键ID (UUIDv7，单次发布版本身份)
  id                      String                @id @default(uuid(7)) @db.Uuid
  /// 所属 BOM 版本族ID
  bomId                   String                @map("bom_id") @db.Uuid
  /// 复制来源版本ID (记录衍生链条)
  basedOnVersionId        String?               @map("based_on_version_id") @db.Uuid
  /// 版本序号数字 (如 1, 2, 3)
  versionNumber           Int                   @map("version_number")
  /// 版本状态: DRAFT(草稿) / PUBLISHED(已发布) / RETIRED(已废止)
  versionStatus           String                @default("DRAFT") @map("version_status") @db.VarChar(16)
  /// 本版本 BOM 业务编码
  code                    String                @map("code") @db.VarChar(64)
  /// 本版本 BOM 名称
  name                    String                @map("name") @db.VarChar(128)
  /// BOM 业务类型: PROCESSING(单品加工) / FORMULA(组合配方) / PACKAGING(包装装配)
  bomType                 String                @map("bom_type") @db.VarChar(24)
  /// 版本描述与配方说明
  description             String?               @map("description") @db.Text
  /// 指定生产产线ID (选填)
  productionLineId        String?               @map("production_line_id") @db.Uuid
  /// 数量模式: FIXED(固定数量) / RATIO(比例配方)
  quantityMode            String                @default("FIXED") @map("quantity_mode") @db.VarChar(16)
  /// 是否启用总出成率控制
  totalYieldEnabled       Boolean               @default(false) @map("total_yield_enabled")
  /// 总出成率数值 (0~1)
  totalYieldRate          Decimal?              @map("total_yield_rate") @db.Decimal(12, 8)
  /// 投入行默认熟出成率参考值
  defaultCookedYieldRate  Decimal?              @map("default_cooked_yield_rate") @db.Decimal(12, 8)
  /// 本版本最小生产批量
  minimumBatchQuantity    Decimal?              @map("minimum_batch_quantity") @db.Decimal(20, 6)
  /// 最小批量单位ID (关联 UnitOfMeasure.id)
  minimumBatchUnitId      String?               @map("minimum_batch_unit_id") @db.Uuid
  /// 生效时间
  effectiveFrom           DateTime?             @map("effective_from")
  /// 失效时间
  effectiveTo             DateTime?             @map("effective_to")
  /// 版本变更原因
  changeReason            String?               @map("change_reason") @db.Text
  /// 发布人用户ID
  publishedById           String?               @map("published_by_id") @db.Uuid
  /// 发布时间戳
  publishedAt             DateTime?             @map("published_at")
  /// 乐观锁版本号
  rowVersion              Int                   @default(0) @map("row_version")

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById             String                @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                  String?               @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById             String?               @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted               Boolean               @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt               DateTime?             @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById             String?               @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt               DateTime              @default(now()) @map("created_at")
  /// 更新时间
  updatedAt               DateTime              @updatedAt @map("updated_at")

  bom                     Bom                   @relation("BomToVersions", fields: [bomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentOfBom            Bom?                  @relation("BomCurrentPublishedVersion")
  basedOnVersion          BomVersion?           @relation("BomVersionDerivation", fields: [basedOnVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedVersions         BomVersion[]          @relation("BomVersionDerivation")
  productionLine          ProductionLine?       @relation(fields: [productionLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  inputs                  BomVersionInput[]
  outputs                 BomVersionOutput[]
  operations              BomVersionOperation[]
  childVersionInputs      BomVersionInput[]     @relation("BomInputChildVersion")

  @@unique([bomId, versionNumber])
  @@index([bomId, versionStatus, effectiveFrom])
  @@index([code, versionStatus, isDeleted])
  @@index([deptId])
  @@map("bom_version")
}

/// 商品默认 BOM 映射表
model ProductDefaultBom {
  /// 主键ID (UUIDv7)
  id          String    @id @default(uuid(7)) @db.Uuid
  /// 目标商品ID (关联 Product.id)
  productId   String    @map("product_id") @db.Uuid
  /// 指定默认 BOM 版本族ID
  bomId       String    @map("bom_id") @db.Uuid

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId      String?   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById String?   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt   DateTime? @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime  @updatedAt @map("updated_at")

  bom         Bom       @relation(fields: [bomId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, bomId])
  @@index([productId, isDeleted])
  @@index([bomId, isDeleted])
  @@index([deptId])
  @@map("product_default_bom")
}

/// BOM 版本标准投入清单表 (用什么、用多少)
model BomVersionInput {
  /// 主键ID (UUIDv7)
  id                 String      @id @default(uuid(7)) @db.Uuid
  /// 所属 BOM 完整版本ID
  bomVersionId       String      @map("bom_version_id") @db.Uuid
  /// 投入物料商品ID (关联 Product.id)
  productId          String      @map("product_id") @db.Uuid
  /// 标准毛投入量 (FIXED 模式必填)
  quantity           Decimal?    @map("quantity") @db.Decimal(20, 6)
  /// 投入计量单位ID (关联 UnitOfMeasure.id)
  unitId             String      @map("unit_id") @db.Uuid
  /// 配方占比 (RATIO 模式必填，0~1)
  ratio              Decimal?    @map("ratio") @db.Decimal(12, 8)
  /// 物料角色: MAIN(主料) / AUXILIARY(辅料) / PACKAGING(包材) / PROCESSING_AID(加工助剂)
  materialRole       String      @default("MAIN") @map("material_role") @db.VarChar(24)
  /// 原料熟出成率参考值 (0~1)
  cookedYieldRate    Decimal?    @map("cooked_yield_rate") @db.Decimal(12, 8)
  /// 正常损耗率参考值 (0~1)
  normalLossRate     Decimal?    @map("normal_loss_rate") @db.Decimal(12, 8)
  /// 供应策略: EXTERNAL(外购) / MAKE(生产自制) / PRODUCT_DEFAULT(跟随商品默认方案)
  supplyPolicy       String      @default("EXTERNAL") @map("supply_policy") @db.VarChar(24)
  /// 草稿选定的下层子 BOM 族ID
  childBomId         String?     @map("child_bom_id") @db.Uuid
  /// 发布时锁定的下层子 BOM 版本ID
  childBomVersionId  String?     @map("child_bom_version_id") @db.Uuid
  /// 页面展示排序
  sortOrder          Int         @default(0) @map("sort_order")
  /// 行备注说明
  remark             String?     @map("remark") @db.VarChar(255)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById        String      @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId             String?     @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById        String?     @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted          Boolean     @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt          DateTime?   @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById        String?     @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt          DateTime    @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime    @updatedAt @map("updated_at")

  bomVersion         BomVersion  @relation(fields: [bomVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childBom           Bom?        @relation("BomInputChildScheme", fields: [childBomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childBomVersion    BomVersion? @relation("BomInputChildVersion", fields: [childBomVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([bomVersionId, sortOrder])
  @@index([productId])
  @@index([childBomVersionId])
  @@map("bom_version_input")
}

/// BOM 版本标准产出清单表 (产什么、产多少；PRIMARY 唯一主产出即 BOM 商品)
model BomVersionOutput {
  /// 主键ID (UUIDv7)
  id                  String     @id @default(uuid(7)) @db.Uuid
  /// 所属 BOM 完整版本ID
  bomVersionId        String     @map("bom_version_id") @db.Uuid
  /// 产出物料商品ID (关联 Product.id)
  productId           String     @map("product_id") @db.Uuid
  /// 标准批次产出数量
  quantity            Decimal    @map("quantity") @db.Decimal(20, 6)
  /// 产出计量单位ID (关联 UnitOfMeasure.id)
  unitId              String     @map("unit_id") @db.Uuid
  /// 产出角色: PRIMARY(主产品，单版本严格唯一) / BYPRODUCT(联副产品)
  outputRole          String     @default("PRIMARY") @map("output_role") @db.VarChar(24)
  /// 成本分摊比例 (0~1)
  costAllocationRatio Decimal?   @map("cost_allocation_ratio") @db.Decimal(12, 8)
  /// 页面展示排序
  sortOrder           Int        @default(0) @map("sort_order")
  /// 行备注说明
  remark              String?    @map("remark") @db.VarChar(255)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById         String     @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId              String?    @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById         String?    @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted           Boolean    @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt           DateTime?  @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById         String?    @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt           DateTime   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt           DateTime   @updatedAt @map("updated_at")

  bomVersion          BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([bomVersionId, outputRole, sortOrder])
  @@index([productId])
  @@map("bom_version_output")
}

/// BOM 版本有序工艺清单表 (怎么做、经过哪些工序)
model BomVersionOperation {
  /// 主键ID (UUIDv7)
  id                         String                   @id @default(uuid(7)) @db.Uuid
  /// 所属 BOM 完整版本ID
  bomVersionId               String                   @map("bom_version_id") @db.Uuid
  /// 工序ID
  operationId                String                   @map("operation_id") @db.Uuid
  /// 选定的加工规格ID (选填)
  processingSpecificationId  String?                  @map("processing_specification_id") @db.Uuid
  /// 工艺顺序号 (如 10, 20, 30)
  sequenceNumber             Int                      @map("sequence_number")
  /// 本版本覆盖准备时间 (分钟)
  setupMinutes               Int?                     @map("setup_minutes")
  /// 本版本覆盖清理时间 (分钟)
  cleanupMinutes             Int?                     @map("cleanup_minutes")
  /// 标准工时 (小时)
  standardLaborHours         Decimal?                 @map("standard_labor_hours") @db.Decimal(12, 4)
  /// 是否质检控制点
  qualityCheckpoint          Boolean                  @default(false) @map("quality_checkpoint")
  /// 本版本特定操作指引
  instructionText            String?                  @map("instruction_text") @db.Text
  /// 差异化加工参数 (温度、时间、切刀尺寸等 JSON)
  instructionParameters      Json?                    @map("instruction_parameters")
  /// 页面展示排序
  sortOrder                  Int                      @default(0) @map("sort_order")
  /// 行备注说明
  remark                     String?                  @map("remark") @db.VarChar(255)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById                String                   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                     String?                  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById                String?                  @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                  Boolean                  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                  DateTime?                @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById                String?                  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                  DateTime                 @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  bomVersion                 BomVersion               @relation(fields: [bomVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation                  Operation                @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  processingSpecification    ProcessingSpecification? @relation(fields: [processingSpecificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([bomVersionId, sequenceNumber])
  @@index([operationId])
  @@map("bom_version_operation")
}
