generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-supplier-center"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

/// 供应商主档表
model Supplier {
  /// 主键ID (UUIDv7)
  id               String            @id @default(uuid(7)) @db.Uuid
  /// 供应商编码 (全表唯一)
  code             String            @unique @map("code") @db.VarChar(64)
  /// 供应商全称
  name             String            @map("name") @db.VarChar(128)
  /// 供应商简称
  shortName        String?           @map("short_name") @db.VarChar(64)
  /// 默认联系人姓名
  contactName      String?           @map("contact_name") @db.VarChar(64)
  /// 默认联系人电话
  contactPhone     String?           @map("contact_phone") @db.VarChar(32)
  /// 备注说明
  remark           String?           @map("remark") @db.VarChar(255)
  /// 状态: ACTIVE(正常) / DISABLED(停用)
  status           String            @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById      String            @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId           String?           @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById      String?           @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted        Boolean           @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt        DateTime?         @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById      String?           @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // 内部关系
  supplierProducts SupplierProduct[]

  @@index([status])
  @@map("supplier")
}

/// 供应商可供商品关系表
model SupplierProduct {
  /// 主键ID (UUIDv7)
  id                   String    @id @default(uuid(7)) @db.Uuid
  /// 供应商ID
  supplierId           String    @map("supplier_id") @db.Uuid
  /// 商品ID (关联 Product.id)
  productId            String    @map("product_id") @db.Uuid
  /// 供应商端商品物料编码
  supplierProductCode  String?   @map("supplier_product_code") @db.VarChar(128)
  /// 采购单位ID (关联 UnitOfMeasure.id)
  purchaseUnitId       String    @map("purchase_unit_id") @db.Uuid
  /// 最小起订量 (按采购单位)
  minimumOrderQuantity Decimal?  @map("minimum_order_quantity") @db.Decimal(20, 6)
  /// 采购提前期 (小时)
  leadTimeHours        Int?      @map("lead_time_hours")
  /// 是否该商品的默认供应商
  isDefault            Boolean   @default(false) @map("is_default")
  /// 状态: ACTIVE / DISABLED
  status               String    @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById          String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId               String?   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById          String?   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted            Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt            DateTime? @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById          String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt            DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime  @updatedAt @map("updated_at")

  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([supplierId, productId])
  @@index([productId, status])
  @@index([status])
  @@map("supplier_product")
}
