generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-warehouse-center"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

/// 仓库主档表
model Warehouse {
  /// 主键ID (UUIDv7)
  id                        String              @id @default(uuid(7)) @db.Uuid
  /// 仓库编码 (全表唯一)
  code                      String              @unique @map("code") @db.VarChar(64)
  /// 仓库名称
  name                      String              @map("name") @db.VarChar(128)
  /// 仓库类型字典项ID (WAREHOUSE_TYPE)
  warehouseTypeDictItemId   String              @map("warehouse_type_dict_item_id") @db.Uuid
  /// 温层分类字典项ID (TEMPERATURE_ZONE)
  temperatureZoneDictItemId String?             @map("temperature_zone_dict_item_id") @db.Uuid
  /// 状态: ACTIVE / DISABLED
  status                    String              @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById               String              @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                    String?             @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById               String?             @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                 Boolean             @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                 DateTime?           @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById               String?             @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                 DateTime            @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  locations                 WarehouseLocation[]

  @@index([warehouseTypeDictItemId, status])
  @@index([status])
  @@map("warehouse")
}

/// 库位定义表
model WarehouseLocation {
  /// 主键ID (UUIDv7)
  id                        String    @id @default(uuid(7)) @db.Uuid
  /// 所属仓库ID
  warehouseId               String    @map("warehouse_id") @db.Uuid
  /// 仓库内库位编码
  code                      String    @map("code") @db.VarChar(64)
  /// 区域 (Zone)
  zone                      String?   @map("zone") @db.VarChar(64)
  /// 货架 (Shelf)
  shelf                     String?   @map("shelf") @db.VarChar(64)
  /// 层 (Layer)
  layer                     String?   @map("layer") @db.VarChar(64)
  /// 位 (Position)
  position                  String?   @map("position") @db.VarChar(64)
  /// 温层字典项ID (可覆盖仓库默认温层)
  temperatureZoneDictItemId String?   @map("temperature_zone_dict_item_id") @db.Uuid
  /// 状态: ACTIVE / DISABLED
  status                    String    @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById               String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                    String?   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById               String?   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                 DateTime? @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById               String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                 DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  warehouse                 Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
  @@index([status])
  @@map("warehouse_location")
}
