// Generated canonical schema. Do not edit directly.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


/// 租户数据库生命周期状态枚举
enum TenantDatabaseStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

/// 租户数据库迁移批次执行状态枚举
enum TenantMigrationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

/// 第三方或本地账号绑定信息表 (Better Auth Account)
model Account {
  /// 绑定账号唯一记录ID
  id                    String    @id @default(uuid(7)) @db.Uuid
  /// 供应商侧的用户唯一ID (如微信openid/OAuth sub)
  accountId             String    @map("account_id")
  /// 身份凭据提供方类型 (如 credential, github 等)
  providerId            String    @map("provider_id")
  /// 关联平台用户主键ID
  userId                String    @map("user_id") @db.Uuid
  /// OAuth 访问令牌
  accessToken           String?   @map("access_token")
  /// OAuth 刷新令牌
  refreshToken          String?   @map("refresh_token")
  /// OIDC 身份令牌
  idToken               String?   @map("id_token")
  /// 访问令牌过期时间
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  /// 刷新令牌过期时间
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  /// OAuth 授权作用域
  scope                 String?
  /// 哈希加密后的本地密码凭据
  password              String?
  /// 记录绑定时间
  createdAt             DateTime  @default(now()) @map("created_at")
  /// 记录更新时间
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// 租户邀请记录表
model Invitation {
  /// 邀请记录ID
  id             String       @id @default(uuid(7)) @db.Uuid
  /// 目标租户企业ID
  organizationId String       @map("organization_id") @db.Uuid
  /// 受邀人邮箱地址
  email          String
  /// 预分配角色
  role           String?
  /// 邀请状态: pending / accepted / rejected / canceled
  status         String       @default("pending")
  /// 邀请链接有效期截止时间
  expiresAt      DateTime     @map("expires_at")
  /// 发起邀请时间
  createdAt      DateTime     @default(now()) @map("created_at")
  /// 邀请人用户ID
  inviterId      String       @map("inviter_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// 租户企业成员归属表 (关联 User 与 Organization)
model Member {
  /// 成员记录ID
  id             String       @id @default(uuid(7)) @db.Uuid
  /// 所属租户企业ID
  organizationId String       @map("organization_id") @db.Uuid
  /// 平台用户ID
  userId         String       @map("user_id") @db.Uuid
  /// 成员角色 (owner / admin / member)
  role           String       @default("member")
  /// 加入企业时间
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

/// 平台租户企业空间表 (Organization)
model Organization {
  /// 租户企业唯一ID
  id                   String          @id @default(uuid(7)) @db.Uuid
  /// 租户企业全称
  name                 String
  /// 租户英文代号 (Subdomain/Slug)
  slug                 String          @unique
  /// 企业徽标 Logo URL
  logo                 String?
  /// 企业入驻创建时间
  createdAt            DateTime        @default(now()) @map("created_at")
  /// 扩展元数据 (JSON)
  metadata             String?
  /// 权限版本号 (CASL 缓存失效基准)
  authorizationVersion Int             @default(1) @map("authorization_version")
  members              Member[]
  invitations          Invitation[]
  roles                OrganizationRole[]
  tenantDatabase       TenantDatabase?
  migrations           TenantMigration[]
  tenantAccounts       TenantAccount[]

  @@map("organization")
}

/// 企业自定义权限角色表
model OrganizationRole {
  /// 角色主键ID
  id             String       @id @default(uuid(7)) @db.Uuid
  /// 归属租户企业ID
  organizationId String       @map("organization_id") @db.Uuid
  /// 角色代号
  role           String
  /// CASL 声明权限策略 JSON
  permission     String
  /// 角色创建时间
  createdAt      DateTime     @default(now()) @map("created_at")
  /// 角色最后更新时间
  updatedAt      DateTime?    @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([role])
  @@map("organization_role")
}

/// 平台总控库版本演进与迁移执行台账 (12-Factor 自愈基线账本)
model PlatformMigration {
  /// 迁移版本时间戳
  version       String   @id @db.VarChar(30)
  /// 迁移名称或标识 (如 baseline)
  migrationName String   @map("migration_name") @db.VarChar(100)
  /// 迁移脚本 SHA-256 校验和
  checksum      String   @db.VarChar(64)
  /// 迁移应用时间戳
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamp(3)

  @@map("platform_migration")
}

/// 用户认证会话表 (Better Auth Session)
model Session {
  /// 会话唯一ID
  id                   String   @id @default(uuid(7)) @db.Uuid
  /// 会话过期时间戳
  expiresAt            DateTime @map("expires_at")
  /// 会话安全令牌 Token
  token                String   @unique
  /// 会话建立时间
  createdAt            DateTime @default(now()) @map("created_at")
  /// 会话更新时间
  updatedAt            DateTime @updatedAt @map("updated_at")
  /// 客户端 IP 地址
  ipAddress            String?  @map("ip_address")
  /// 客户端 User-Agent
  userAgent            String?  @map("user_agent")
  /// 关联用户主键ID
  userId               String   @map("user_id") @db.Uuid
  /// 当前处于激活上下文的租户企业ID
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

/// 租户企业私有凭据表 (Tenant-Scoped Account 独立认证事实源)
model TenantAccount {
  /// 凭据记录ID
  id             String       @id @default(uuid(7)) @db.Uuid
  /// 所属租户企业ID
  organizationId String       @map("organization_id") @db.Uuid
  /// 登录账号 (支持手机号、工号、自定义英文用户名，租户内唯一)
  account        String       @db.VarChar(64)
  /// Scrypt 加盐哈希加密后的密码凭据
  password       String       @db.VarChar(255)
  /// 员工真实姓名
  name           String       @db.VarChar(100)
  /// 绑定关联的租户 Member ID (用于精准对齐 CASL 权限)
  memberId       String?      @map("member_id") @db.Uuid
  /// 账号状态: ACTIVE (启用) / DISABLED (停用)
  status         String       @default("ACTIVE") @db.VarChar(20)
  /// 账号创建时间
  createdAt      DateTime     @default(now()) @map("created_at")
  /// 账号更新时间
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, account])
  @@index([organizationId])
  @@index([memberId])
  @@map("tenant_account")
}

/// 租户物理独立数据库路由事实源 (Database-per-tenant 拓扑总账)
model TenantDatabase {
  /// 数据库拓扑记录ID
  id             String               @id @default(uuid(7)) @db.Uuid
  /// 关联租户企业ID (1:1 物理隔离绑定)
  organizationId String               @unique @map("organization_id") @db.Uuid
  /// 所在物理集群代号 (如 pg-cluster-sh-01)
  clusterCode    String               @map("cluster_code")
  /// 独立物理数据库名 (如 tenant_xxx)
  databaseName   String               @map("database_name")
  /// 连接凭据密钥引用标识
  secretRef      String               @map("secret_ref")
  /// 当前物理库已应用的最新 Schema 版本号
  schemaVersion  String               @map("schema_version")
  /// 数据库生命周期状态: PROVISIONING / ACTIVE / SUSPENDED / FAILED
  status         TenantDatabaseStatus @default(PROVISIONING)
  /// 数据库开通分配时间
  createdAt      DateTime             @default(now()) @map("created_at")
  /// 拓扑信息更新时间
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clusterCode, status])
  @@map("tenant_database")
}

/// 租户数据库版本演进与增量迁移执行台账
model TenantMigration {
  /// 迁移执行记录ID
  id              String                @id @default(uuid(7)) @db.Uuid
  /// 目标租户企业ID
  organizationId  String                @map("organization_id") @db.Uuid
  /// 迁移名称
  migrationName   String                @map("migration_name")
  /// 迁移版本时间戳
  version         String
  /// 所属批量发布批次ID
  batchId         String?               @map("batch_id")
  /// 当前迁移执行状态
  status          TenantMigrationStatus @default(PENDING)
  /// 已执行完成的 Step 数
  appliedSteps    Int                   @default(0) @map("applied_steps")
  /// 失败异常信息详情
  errorMessage    String?               @map("error_message")
  /// 物理执行耗时 (毫秒)
  executionTimeMs Int?                  @map("execution_time_ms")
  /// 执行开始时间戳
  startedAt       DateTime?             @map("started_at")
  /// 执行结束时间戳
  finishedAt      DateTime?             @map("finished_at")
  /// 任务创建时间
  createdAt       DateTime              @default(now()) @map("created_at")
  /// 任务更新时间
  updatedAt       DateTime              @updatedAt @map("updated_at")
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([batchId])
  @@index([organizationId, version])
  @@map("tenant_migration")
}

/// 平台用户账号表 (Better Auth 核心认证主体)
model User {
  /// 用户全局唯一标识 UUID
  id            String       @id @default(uuid(7)) @db.Uuid
  /// 用户姓名或称谓
  name          String
  /// 用户登录邮箱 (唯一)
  email         String       @unique
  /// 邮箱是否已通过验证
  emailVerified Boolean      @default(false) @map("email_verified")
  /// 用户头像 URL
  image         String?
  /// 注册创建时间
  createdAt     DateTime     @default(now()) @map("created_at")
  /// 资料最后更新时间
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[] @relation("InvitationInviter")

  @@map("user")
}

/// 安全验证凭据表 (邮箱激活/重置密码验证码)
model Verification {
  /// 验证记录ID
  id         String   @id @default(uuid(7)) @db.Uuid
  /// 验证标识 (如邮箱地址/手机号)
  identifier String
  /// 动态验证码或加密令牌哈希
  value      String
  /// 验证码有效截止时间
  expiresAt  DateTime @map("expires_at")
  /// 生成发送时间
  createdAt  DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}