// Generated canonical schema. Do not edit directly.
datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}


/// 通用业务附件元数据模型 (Tenant DB 物理隔离，严格对齐 ADR-009 实体审计基线)
model Attachment {
  /// 附件主键ID
  id          String    @id @default(uuid(7)) @db.Uuid
  /// 归属业务模块 (如 employee, customer, item 等)
  module      String    @db.VarChar(50)
  /// 关联业务实体主键ID (如员工档案ID、客户ID)
  targetId    String?   @map("target_id") @db.VarChar(64)
  /// 业务字段标识 (如 avatar, id_card, attachment 等)
  fieldKey    String?   @map("field_key") @db.VarChar(50)
  /// 原始文件名
  fileName    String    @map("file_name") @db.VarChar(255)
  /// 对象存储内部 Key
  storageKey  String    @map("storage_key") @db.VarChar(500)
  /// 访问 URL
  fileUrl     String    @map("file_url") @db.VarChar(1000)
  /// 文件大小 (字节)
  fileSize    BigInt    @map("file_size")
  /// MIME 类型
  mimeType    String    @map("mime_type") @db.VarChar(100)

  /// 创建人 ID (必填，审计基线，UUIDv7)
  createdById String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (选填，支持部门数据范围权限过滤，UUIDv7)
  deptId      String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (选填，UUIDv7)
  updatedById String?   @map("updated_by_id") @db.Uuid
  /// 创建时间 (必填)
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间 (必填)
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// 软删除标记 (必填)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  /// 软删除时间 (选填)
  deletedAt   DateTime? @map("deleted_at")
  /// 软删除人 ID (选填，UUIDv7)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([targetId, module])
  @@index([createdById])
  @@map("attachment")
}

/// 租户企业扩展资料模型 (与平台 Organization 动静分离)
model CompanyProfile {
  /// 企业扩展资料主键ID
  id           String   @id @default(uuid(7)) @db.Uuid
  /// 企业主体注册全称
  companyName  String   @map("company_name")
  /// 企业简称/品牌名
  shortName    String?  @map("short_name")
  /// 统一社会信用代码
  creditCode   String?  @map("credit_code")
  /// 法定代表人姓名
  legalPerson  String?  @map("legal_person")
  /// 官方业务联系电话
  contactPhone String?  @map("contact_phone")
  /// 官方业务联系邮箱
  contactEmail String?  @map("contact_email")
  /// 经营办公/注册地址
  address      String?
  /// 业务时区 (默认 Asia/Shanghai)
  timezone     String   @default("Asia/Shanghai")
  /// 结算本位币种 (默认 CNY)
  currency     String   @default("CNY")
  /// 记录创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 记录更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

/// 客户档案主表：维护企业级客户的基本信息与结算主数据
model Customer {
  /// 客户主键ID (UUIDv7)
  id               String   @id @default(uuid(7)) @db.Uuid
  /// 客户企业名称
  name             String   @map("name") @db.VarChar(100)
  /// 所属客户分类主键ID
  categoryId       String   @map("category_id") @db.Uuid
  /// 核心联系人姓名
  contactPerson    String   @map("contact_person") @db.VarChar(50)
  /// 联系电话
  contactPhone     String   @map("contact_phone") @db.VarChar(20)
  /// 结算方式：MONTHLY(月结) / CASH(现结) / PREPAID(预付)
  settlementMethod String   @map("settlement_method") @db.VarChar(20)
  /// 默认税率(%)，如 9.00 表示 9%
  defaultTaxRate   Decimal? @map("default_tax_rate") @db.Decimal(5, 2)
  /// 授信信用额度(元)
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(12, 2)
  /// 客户标签摘要缓存（冗余字段，方便快速搜索展示）
  customerTags     String?  @map("customer_tags") @db.VarChar(200)
  /// 负责销售经理 / 业务员姓名或工号
  salesPerson      String?  @map("sales_person") @db.VarChar(50)
  /// 默认发货仓库标识
  defaultWarehouse String?  @map("default_warehouse") @db.VarChar(50)
  /// 付款周期：WEEKLY(周结) / BIWEEKLY(半月结) / MONTHLY(月结)
  paymentCycle     String?  @map("payment_cycle") @db.VarChar(20)
  /// 服务收货时间窗口（如：早8:00-10:00）
  serviceTime      String?  @map("service_time") @db.VarChar(50)
  /// 最近下单履约时间（系统只读自动更新）
  lastOrderTime    DateTime? @map("last_order_time")
  /// 客户状态：ACTIVE(正常) / DISABLED(停用)
  status           String   @default("ACTIVE") @db.VarChar(10)
  /// 创建人用户ID
  createdById      String   @map("created_by_id") @db.Uuid
  /// 归属部门ID (用于数据范围判定)
  deptId           String?  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID
  updatedById      String?  @map("updated_by_id") @db.Uuid
  /// 软删除标记
  isDeleted        Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt        DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById      String?  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt        DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// 所属分类关联
  category         CustomerCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 客户关联的多标签记录
  tagAssignments   CustomerTagAssignment[]
  /// 该客户下属的多个门店列表
  stores           CustomerStore[]
  /// 针对该客户的专属报价单列表
  quotes           CustomerQuote[]

  @@index([categoryId])
  @@index([status])
  @@index([isDeleted])
  @@map("customer")
}

/// 客户分类表：支持多级层级树结构（如餐饮连锁、企事业单位、生鲜超市）
model CustomerCategory {
  /// 分类主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 分类名称（如：机关食堂、品牌连锁）
  name        String   @map("name") @db.VarChar(50)
  /// 父级分类主键ID（支持多级分类树，根级为空）
  parentId    String?  @map("parent_id") @db.Uuid
  /// 分类业务描述
  description String?  @db.VarChar(200)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @db.VarChar(10)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 自引用：父级分类
  parent      CustomerCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 自引用：子级分类列表
  children    CustomerCategory[] @relation("CategoryHierarchy")
  /// 该分类下的客户档案列表
  customers   Customer[]

  @@index([parentId])
  @@index([status])
  @@map("customer_category")
}

/// 门店报价单主表：按客户+门店+区域维护的商品定价单头
model CustomerQuote {
  /// 报价单主键ID (UUIDv7)
  id              String    @id @default(uuid(7)) @db.Uuid
  /// 报价单业务单号（对外沟通展示与防重，格式 QUOT-YYYYMMDD-XXXX）
  quoteNo         String    @unique @map("quote_no") @db.VarChar(30)
  /// 适用客户主键ID（与 storeId、regionCode 构成维度优先级）
  customerId      String?   @map("customer_id") @db.Uuid
  /// 适用门店主键ID（为空则适用于该客户下属所有门店）
  storeId         String?   @map("store_id") @db.Uuid
  /// 适用区域编码（客户与门店均为空时，作为该区域通用报价单）
  regionCode      String?   @map("region_code") @db.VarChar(50)
  /// 报价单拟定日期
  quoteDate       DateTime  @map("quote_date") @db.Date
  /// 价格生效日期
  effectiveDate   DateTime  @map("effective_date") @db.Date
  /// 价格失效日期（为空表示长期有效）
  expiryDate      DateTime? @map("expiry_date") @db.Date
  /// 报价单类型：STANDARD(普通报价单) / CYCLE(周期报价单)
  quoteType       String    @default("STANDARD") @map("quote_type") @db.VarChar(20)
  /// 对外展示简称（供客户查看核对的报价单名称）
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// 包含的商品明细条目总数（系统自动汇总）
  itemCount       Int       @default(0) @map("item_count")
  /// 关联客户总数（只读统计）
  customerCount   Int       @default(0) @map("customer_count")
  /// 单据状态：DRAFT(草稿) / ACTIVE(已生效) / EXPIRED(已过期) / VOIDED(已作废)
  status          String    @default("DRAFT") @db.VarChar(10)
  /// 创建人姓名或工号
  createdBy       String    @map("created_by") @db.VarChar(50)
  /// 创建人用户ID
  createdById     String    @map("created_by_id") @db.Uuid
  /// 归属部门ID
  deptId          String?   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID
  updatedById     String?   @map("updated_by_id") @db.Uuid
  /// 软删除标记
  isDeleted       Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById     String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// 关联客户档案
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 关联门店档案
  store           CustomerStore? @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 报价单包含的商品明细列表
  items           CustomerQuoteItem[]

  @@index([customerId])
  @@index([storeId])
  @@index([regionCode])
  @@index([status])
  @@index([isDeleted])
  @@map("customer_quote")
}

/// 门店报价单明细表：具体商品的含税与不含税单价及起订限制
model CustomerQuoteItem {
  /// 报价明细行主键ID (UUIDv7)
  id                String   @id @default(uuid(7)) @db.Uuid
  /// 所属报价单主表ID
  quoteId           String   @map("quote_id") @db.Uuid
  /// 商品档案唯一编码（关联物料商品中心）
  itemCode          String   @map("item_code") @db.VarChar(50)
  /// 商品名称（如：特级上海青(净菜)）
  itemName          String   @map("item_name") @db.VarChar(100)
  /// 销售计量单位（如：kg、箱、袋）
  salesUnit         String   @map("sales_unit") @db.VarChar(20)
  /// 不含税单价（元）
  unitPriceExclTax  Decimal  @map("unit_price_excl_tax") @db.Decimal(10, 2)
  /// 含税销售单价（元）
  unitPriceInclTax  Decimal  @map("unit_price_incl_tax") @db.Decimal(10, 2)
  /// 适用增值税税率(%)，如 9.00
  taxRate           Decimal  @map("tax_rate") @db.Decimal(5, 2)
  /// 最小起订量限制
  minQty            Decimal? @map("min_qty") @db.Decimal(10, 2)
  /// 最大限购量限制
  maxQty            Decimal? @map("max_qty") @db.Decimal(10, 2)
  /// 明细备注说明
  remark            String?  @db.VarChar(200)

  /// 所属报价单主表关联
  quote             CustomerQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([quoteId])
  @@index([itemCode])
  @@map("customer_quote_item")
}

/// 门店档案主表：客户下属的履约单位（订单、配送、签收、对账最小主体）
model CustomerStore {
  /// 门店主键ID (UUIDv7)
  id              String   @id @default(uuid(7)) @db.Uuid
  /// 所属客户主键ID（外键关联 Customer.id）
  customerId      String   @map("customer_id") @db.Uuid
  /// 门店详细名称（如：海淀中关村一店）
  name            String   @map("name") @db.VarChar(100)
  /// 门店配送收货详细地址
  address         String   @db.VarChar(200)
  /// 门店现场联系人
  contactPerson   String   @map("contact_person") @db.VarChar(50)
  /// 门店联系电话
  contactPhone    String   @map("contact_phone") @db.VarChar(20)
  /// 配送时段：MORNING(早) / NOON(中) / EVENING(晚)
  deliveryPeriod  String?  @map("delivery_period") @db.VarChar(50)
  /// 默认配送路线编码
  defaultRoute    String?  @map("default_route") @db.VarChar(50)
  /// 默认配送司机名称或工号
  defaultDriver   String?  @map("default_driver") @db.VarChar(50)
  /// 门店标签摘要（如 VIP门店、商圈旗舰）
  storeTags       String?  @map("store_tags") @db.VarChar(200)
  /// 所属区域编码（必填，用于区域报价匹配与物流调度）
  regionCode      String   @map("region_code") @db.VarChar(50)
  /// 结款财务联系人（门店现场收货人≠结款人时使用）
  billingContact  String?  @map("billing_contact") @db.VarChar(50)
  /// 结款财务联系人电话
  billingPhone    String?  @map("billing_phone") @db.VarChar(20)
  /// 门店状态：ACTIVE(正常) / DISABLED(停用)
  status          String   @default("ACTIVE") @db.VarChar(10)
  /// 创建人用户ID
  createdById     String   @map("created_by_id") @db.Uuid
  /// 归属部门ID
  deptId          String?  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID
  updatedById     String?  @map("updated_by_id") @db.Uuid
  /// 软删除标记
  isDeleted       Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById     String?  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt       DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime @updatedAt @map("updated_at")

  /// 所属客户
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 针对该门店的独立报价单列表
  quotes          CustomerQuote[]

  @@index([customerId])
  @@index([regionCode])
  @@index([status])
  @@index([isDeleted])
  @@map("customer_store")
}

/// 客户标签字典表：用于筛选、统计、报价与配送策略
model CustomerTag {
  /// 标签主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 标签名称（如：早间配送、VIP客户、学校食堂）
  name        String   @map("name") @db.VarChar(50)
  /// 业务标签类型ID：关联基础档案 tenant_dict_item 的主键 id
  tagTypeId   String?  @map("tag_type_id") @db.Uuid
  /// 标签业务说明
  description String?  @db.VarChar(200)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @db.VarChar(10)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 关联的客户标签记录
  assignments CustomerTagAssignment[]

  @@index([tagTypeId])
  @@index([status])
  @@map("customer_tag")
}

/// 客户与标签多对多关联表
model CustomerTagAssignment {
  /// 客户主键ID
  customerId String   @map("customer_id") @db.Uuid
  /// 标签主键ID
  tagId      String   @map("tag_id") @db.Uuid
  /// 关联打标时间
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_assignment")
}

/// 部门拓扑模型 (用于数据范围 DEPT / DEPT_TREE 判定)
model Department {
  /// 部门主键ID (UUIDv7)
  id             String   @id @default(uuid(7)) @db.Uuid
  /// 部门名称
  name           String
  /// 部门业务编码
  code           String   @unique
  /// 父级部门ID (支持树状拓扑)
  parentId       String?  @map("parent_id") @db.Uuid
  /// 部门分管领导/主管成员ID (关联平台 Member.id)
  leaderMemberId String?  @map("leader_member_id")
  /// 显示排序权重 (数字越小越靠前)
  sort           Int      @default(0)
  /// 部门状态: ACTIVE(正常) / DISABLED(停用)
  status         String   @default("ACTIVE")
  /// 创建时间
  createdAt      DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime @updatedAt @map("updated_at")

  employees      EmployeeProfile[]

  @@index([parentId])
  @@index([status])
  @@map("department")
}

/// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  /// 员工档案主键ID
  id                String           @id @default(uuid(7)) @db.Uuid
  /// 关联平台租户成员主键 (Control DB Member.id)
  memberId          String?          @unique @map("member_id")
  /// 关联平台用户账号ID (Control DB User.id)
  userId            String?          @map("user_id")
  /// 邀请记录ID (关联邀请审核流)
  invitationId      String?          @map("invitation_id")
  /// 员工工号 (企业内部唯一)
  employeeNo        String?          @unique @map("employee_no")
  /// 所属部门主键ID
  departmentId      String?          @map("department_id") @db.Uuid
  /// 所属岗位主键ID
  positionId        String?          @map("position_id") @db.Uuid
  /// 直属上级经理档案ID
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  /// 员工姓名
  name              String           @default("") @map("name")
  /// 员工工作邮箱
  email             String           @default("") @map("email")
  /// 员工手机号
  phone             String?          @map("phone")
  /// 职务头衔/对外称谓
  jobTitle          String?          @map("job_title")
  /// 员工头像/工牌照 URL
  avatarUrl         String?          @map("avatar_url")
  /// 员工在职状态: ACTIVE(在职) / TERMINATED(离职) / SUSPENDED(停职)
  status            String           @default("ACTIVE")
  /// 入职报到时间
  joinedAt          DateTime?        @map("joined_at")
  /// 离职归档时间
  terminatedAt      DateTime?        @map("terminated_at")
  /// 档案创建时间
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 档案最后更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at")

  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  manager           EmployeeProfile? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subordinates      EmployeeProfile[] @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([memberId])
  @@index([status])
  @@map("employee_profile")
}

/// 岗位模型 (实现 Position != Role 物理正交解耦)
model Position {
  /// 岗位主键ID
  id          String            @id @default(uuid(7)) @db.Uuid
  /// 岗位名称
  name        String
  /// 岗位业务编码
  code        String            @unique
  /// 岗位职责详细描述
  description String?
  /// 排序权重 (数字越小越靠前)
  sort        Int               @default(0)
  /// 岗位状态: ACTIVE(正常) / DISABLED(停用)
  status      String            @default("ACTIVE")
  /// 创建时间
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime          @updatedAt @map("updated_at")

  employees   EmployeeProfile[]

  @@index([status])
  @@map("position")
}

/// 租户业务基础档案数据字典项表 (租户全域共享配置字典，通过 status 启停用)
model TenantDictItem {
  /// 字典项主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 字典类型编码 (as const 枚举分类，例如 CUSTOMER_LEVEL)
  type        String   @map("type") @db.VarChar(50)
  /// 字典项业务编码 (同一 type 下唯一)
  code        String   @map("code") @db.VarChar(50)
  /// 字典项显示名称
  name        String   @map("name") @db.VarChar(100)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @map("status") @db.VarChar(10)
  /// 显示排序权重 (数字越小越靠前)
  sort        Int      @default(0) @map("sort")
  /// 是否默认选中项
  isDefault   Boolean  @default(false) @map("is_default")
  /// 备注说明
  remark      String?  @map("remark") @db.VarChar(255)
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, status])
  @@index([status])
  @@map("tenant_dict_item")
}

/// 租户动态导航菜单配置模型 (支持现场层级调整、自定义别名与跨切片灵活编排)
model TenantMenuItem {
  /// 节点主键ID
  id           String    @id @default(uuid(7)) @db.Uuid
  /// 父节点ID (空表示顶级大菜单/顶级单页)
  parentId     String?   @map("parent_id") @db.Uuid
  /// 节点类型: GROUP(大菜单/目录分组) | PAGE(具体功能页面) | LINK(外部链接)
  itemType     String    @default("PAGE") @map("item_type")
  /// 关联的标准页面键名 (若 itemType="PAGE"，对应 StandardPageDescriptor.pageKey)
  pageKey      String?   @map("page_key")
  /// 外部跳转 URL (若 itemType="LINK"，如 "https://bi.company.com")
  externalUrl  String?   @map("external_url")
  /// 是否在新标签页打开
  openInNewTab Boolean   @default(false) @map("open_in_new_tab")
  /// 自定义显示别名 (现场实施重命名；空则使用页面契约 defaultLabel)
  customLabel  String?   @map("custom_label")
  /// 自定义图标名称 (空则使用页面契约 defaultIcon)
  customIcon   String?   @map("custom_icon")
  /// 排序权重 (升序排列)
  sortOrder    Int       @default(0) @map("sort_order")
  /// 是否可见
  isVisible    Boolean   @default(true) @map("is_visible")

  /// 创建人 ID (UUIDv7，系统写入为 SYSTEM_ACTOR_ID)
  createdById  String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (UUIDv7)
  deptId       String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (UUIDv7)
  updatedById  String?   @map("updated_by_id") @db.Uuid
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// 软删除标记
  isDeleted    Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt    DateTime? @map("deleted_at")
  /// 软删除人 ID (UUIDv7)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  @@index([parentId, sortOrder])
  @@index([isDeleted])
  @@map("tenant_menu_item")
}