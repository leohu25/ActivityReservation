  /// 同步状态: PENDING(未同步), SYNCED(已同步), FAILED(失败)
  syncStatus  String   @default("PENDING") @map("sync_status") @db.VarChar(20)
  errorMsg    String?  @map("error_msg") @db.VarChar(500)
  /// 关联自动创建的租户系统用户ID
  boundUserId String?  @map("bound_user_id") @db.Uuid

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
