/// 租户动态导航菜单配置模型 (支持现场层级调整、自定义别名与跨切片灵活编排)
model TenantMenuItem {
  /// 节点主键ID
  id           String    @id @default(uuid(7)) @db.Uuid
  /// 父节点ID (空表示顶级大菜单/顶级单页)
  parentId     String?   @map("parent_id") @db.Uuid
  /// 节点类型: GROUP(大菜单/目录分组) | PAGE(具体功能页面) | LINK(外部链接)
  itemType     String    @default("PAGE") @map("item_type")
  /// 关联的标准页面键名 (若 itemType="PAGE"，对应 StandardPageDescriptor.pageKey)
  pageKey      String?   @map("page_key")
  /// 外部跳转 URL (若 itemType="LINK"，如 "https://bi.company.com")
  externalUrl  String?   @map("external_url")
  /// 是否在新标签页打开
  openInNewTab Boolean   @default(false) @map("open_in_new_tab")
  /// 自定义显示别名 (现场实施重命名；空则使用页面契约 defaultLabel)
  customLabel  String?   @map("custom_label")
  /// 自定义图标名称 (空则使用页面契约 defaultIcon)
  customIcon   String?   @map("custom_icon")
  /// 排序权重 (升序排列)
  sortOrder    Int       @default(0) @map("sort_order")
  /// 是否可见
  isVisible    Boolean   @default(true) @map("is_visible")

  /// 创建人 ID (UUIDv7，系统写入为 SYSTEM_ACTOR_ID)
  createdById  String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (UUIDv7)
  deptId       String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (UUIDv7)
  updatedById  String?   @map("updated_by_id") @db.Uuid
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// 软删除标记
  isDeleted    Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt    DateTime? @map("deleted_at")
  /// 软删除人 ID (UUIDv7)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  @@index([parentId, sortOrder])
  @@index([isDeleted])
  @@map("tenant_menu_item")
}

/// 场馆档案表 (Venues)
model Venue {
  /// 主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 场馆编码
  code        String   @unique @db.VarChar(50)
  /// 场馆名称 (如: 宁卫校史馆, 护理实训中心)
  name        String   @db.VarChar(100)
  /// 场馆封面图片 URL
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  /// 详细地址
  address     String?  @db.VarChar(255)
  /// 开放时间描述 (如: 周二至周日 09:00-16:30)
  openTime    String?  @map("open_time") @db.VarChar(100)
  /// 联系电话
  contactPhone String? @map("contact_phone") @db.VarChar(50)
  /// 场馆介绍说明
  description String?  @db.Text
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @db.VarChar(20)
  /// 是否默认主场馆
  isDefault   Boolean  @default(false) @map("is_default")

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  spaces      Space[]
  activities  Activity[]

  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("venue")
}

/// 志愿者申请表 (VolunteerApplication)
model VolunteerApplication {
  id          String   @id @default(uuid(7)) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(50)
  studentNo   String?  @map("student_no") @db.VarChar(50)
  major       String?  @db.VarChar(100)
  serviceRole String?  @map("service_role") @db.VarChar(50)
  status      String   @default("PENDING") @db.VarChar(20)
  auditRemark String?  @map("audit_remark") @db.VarChar(255)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])

  @@index([activityId])
  @@index([phone])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("volunteer_application")
}