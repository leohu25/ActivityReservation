// Generated canonical schema. Do not edit directly.
datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}


/// 活动表 (Activity)
model Activity {
  id          String   @id @default(uuid(7)) @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  title       String   @db.VarChar(150)
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  description String?  @db.Text
  /// 活动类型: GENERAL(普通活动), LECTURE(讲座讲解), VOLUNTEER(志愿服务), INTERNAL(校内专属)
  type        String   @default("GENERAL") @db.VarChar(30)
  /// 预约审核模式: MANUAL(需人工审批), AUTO(自动免审通过)
  auditMode   String   @default("MANUAL") @map("audit_mode") @db.VarChar(20)
  /// 是否允许团队预约
  allowTeam   Boolean  @default(true) @map("allow_team")
  /// 团队最小人数
  minTeamSize Int      @default(5) @map("min_team_size")
  /// 团队最大人数
  maxTeamSize Int      @default(50) @map("max_team_size")
  /// 预约开始日期
  startDate   DateTime @map("start_date")
  /// 预约截止日期
  endDate     DateTime @map("end_date")
  /// 活动状态: DRAFT(草稿), PUBLISHED(已发布), FINISHED(已结束), CANCELLED(已取消)
  status      String   @default("PUBLISHED") @db.VarChar(20)
  /// 排序权重
  sortOrder   Int      @default(0) @map("sort_order")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue    @relation(fields: [venueId], references: [id])
  sessions    ActivitySession[]
  appointments Appointment[]
  volunteers  VolunteerApplication[]

  @@index([venueId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([deptId])
  @@index([isDeleted])
  @@map("activity")
}

/// 活动排班场次表 (ActivitySession)
model ActivitySession {
  id          String   @id @default(uuid(7)) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  spaceId     String?  @map("space_id") @db.Uuid
  /// 场次日期 (如 2026-09-25)
  date        String   @db.VarChar(20)
  /// 开始时间 (如 09:30)
  startTime   String   @map("start_time") @db.VarChar(10)
  /// 结束时间 (如 11:00)
  endTime     String   @map("end_time") @db.VarChar(10)
  /// 总容纳名额
  totalCapacity Int    @default(50) @map("total_capacity")
  /// 已预约名额 (用于并发原子扣减)
  bookedCount Int      @default(0) @map("booked_count")
  /// 指定主讲解员ID (Staff)
  lecturerId  String?  @map("lecturer_id") @db.Uuid
  /// 场次状态: ACTIVE(可预约), FULL(已满额), CANCELLED(已停用)
  status      String   @default("ACTIVE") @db.VarChar(20)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])
  space       Space?   @relation(fields: [spaceId], references: [id])
  appointments Appointment[]

  @@index([activityId])
  @@index([date, startTime])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("activity_session")
}

/// 预约申请单主表 (Appointment)
model Appointment {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// 预约申请单编号 (如 APPT202609240001)
  code          String   @unique @db.VarChar(50)
  activityId    String   @map("activity_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  /// 预约模式: INDIVIDUAL(个人预约), TEAM(团队拼团预约), INTERNAL(校内免审预约)
  type          String   @default("INDIVIDUAL") @db.VarChar(20)
  /// 申请人姓名
  applicantName String   @map("applicant_name") @db.VarChar(100)
  /// 申请人手机号
  phone         String   @db.VarChar(50)
  /// 申请人证件号 / 学号 / 工号
  idCard        String?  @map("id_card") @db.VarChar(50)
  /// 所属单位或组织机构
  organization  String?  @db.VarChar(150)
  /// 预约总人数 (本人 + 同行人 或 团队实到人数)
  peopleCount   Int      @default(1) @map("people_count")
  /// 审批状态: PENDING(待审核), APPROVED(已通过), REJECTED(已驳回), CANCELLED(已取消), CHECKED_IN(已核销入场)
  status        String   @default("PENDING") @db.VarChar(20)
  /// 审批备注 / 驳回理由
  auditRemark   String?  @map("audit_remark") @db.VarChar(255)
  /// 审批人ID
  auditedById   String?  @map("audited_by_id") @db.Uuid
  /// 审批时间
  auditedAt     DateTime? @map("audited_at")
  /// 进场通行凭证签名字串 (用于移动端生成防伪 QR Code)
  qrCodeSign    String?  @map("qr_code_sign") @db.VarChar(255)
  /// 实际现场核销时间
  checkedInAt   DateTime? @map("checked_in_at")

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])
  session     ActivitySession @relation(fields: [sessionId], references: [id])
  visitors    AppointmentVisitor[]
  team        AppointmentTeam?

  @@index([activityId])
  @@index([sessionId])
  @@index([phone])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("appointment")
}

