  /// 分类主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 分类名称（如：机关食堂、品牌连锁）
  name        String   @map("name") @db.VarChar(50)
  /// 父级分类主键ID（支持多级分类树，根级为空）
  parentId    String?  @map("parent_id") @db.Uuid
  /// 分类业务描述
  description String?  @db.VarChar(200)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @db.VarChar(10)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId      String?  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById String?  @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt   DateTime? @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById String?  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 自引用：父级分类
  parent      CustomerCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 自引用：子级分类列表
  children    CustomerCategory[] @relation("CategoryHierarchy")
  /// 该分类下的客户档案列表
  customers   Customer[]

  @@index([parentId])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("customer_category")
}

/// 门店报价单主表：按客户+门店+区域维护的商品定价单头
model CustomerQuote {
  /// 报价单主键ID (UUIDv7)
  id              String    @id @default(uuid(7)) @db.Uuid
  /// 报价单业务单号（对外沟通展示与防重，格式 QUOT-YYYYMMDD-XXXX）
  quoteNo         String    @unique @map("quote_no") @db.VarChar(30)
  /// 适用客户主键ID（与 storeId、regionCode 构成维度优先级）
  customerId      String?   @map("customer_id") @db.Uuid
  /// 适用门店主键ID（为空则适用于该客户下属所有门店）
  storeId         String?   @map("store_id") @db.Uuid
  /// 适用区域编码（客户与门店均为空时，作为该区域通用报价单）
  regionCode      String?   @map("region_code") @db.VarChar(50)
  /// 报价单拟定日期
  quoteDate       DateTime  @map("quote_date") @db.Date
  /// 价格生效日期
  effectiveDate   DateTime  @map("effective_date") @db.Date
  /// 价格失效日期（为空表示长期有效）
  expiryDate      DateTime? @map("expiry_date") @db.Date
  /// 报价单类型：STANDARD(普通报价单) / CYCLE(周期报价单)
  quoteType       String    @default("STANDARD") @map("quote_type") @db.VarChar(20)
  /// 对外展示简称（供客户查看核对的报价单名称）
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// 包含的商品明细条目总数（系统自动汇总）
  itemCount       Int       @default(0) @map("item_count")
  /// 关联客户总数（只读统计）
  customerCount   Int       @default(0) @map("customer_count")
  /// 单据状态：DRAFT(草稿) / ACTIVE(已生效) / EXPIRED(已过期) / VOIDED(已作废)
  status          String    @default("DRAFT") @db.VarChar(10)
  /// 创建人姓名或工号
  createdBy       String    @map("created_by") @db.VarChar(50)
  /// 创建人用户ID
  createdById     String    @map("created_by_id") @db.Uuid
  /// 归属部门ID
  deptId          String?   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID
  updatedById     String?   @map("updated_by_id") @db.Uuid
  /// 软删除标记
  isDeleted       Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById     String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// 关联客户档案
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 关联门店档案
  store           CustomerStore? @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 报价单包含的商品明细列表
  items           CustomerQuoteItem[]

  @@index([customerId])
  @@index([storeId])
  @@index([regionCode])
  @@index([status])
  @@index([isDeleted])
  @@map("customer_quote")
}

/// 门店报价单明细表：具体商品的含税与不含税单价及起订限制
model CustomerQuoteItem {
  /// 报价明细行主键ID (UUIDv7)
  id                String   @id @default(uuid(7)) @db.Uuid
  /// 所属报价单主表ID
  quoteId           String   @map("quote_id") @db.Uuid
  /// 商品档案唯一编码（关联物料商品中心）
  itemCode          String   @map("item_code") @db.VarChar(50)
  /// 商品名称（如：特级上海青(净菜)）
  itemName          String   @map("item_name") @db.VarChar(100)
  /// 销售计量单位（如：kg、箱、袋）
  salesUnit         String   @map("sales_unit") @db.VarChar(20)
  /// 不含税单价（元）
  unitPriceExclTax  Decimal  @map("unit_price_excl_tax") @db.Decimal(10, 2)
  /// 含税销售单价（元）
  unitPriceInclTax  Decimal  @map("unit_price_incl_tax") @db.Decimal(10, 2)
  /// 适用增值税税率(%)，如 9.00
  taxRate           Decimal  @map("tax_rate") @db.Decimal(5, 2)
  /// 最小起订量限制
  minQty            Decimal? @map("min_qty") @db.Decimal(10, 2)
  /// 最大限购量限制
  maxQty            Decimal? @map("max_qty") @db.Decimal(10, 2)
  /// 明细备注说明
  remark            String?  @db.VarChar(200)

  /// 所属报价单主表关联
  quote             CustomerQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([quoteId])
  @@index([itemCode])
  @@map("customer_quote_item")
}

/// 门店档案主表：客户下属的履约单位（订单、配送、签收、对账最小主体）
model CustomerStore {
  /// 门店主键ID (UUIDv7)
  id              String   @id @default(uuid(7)) @db.Uuid
  /// 所属客户主键ID（外键关联 Customer.id）
  customerId      String   @map("customer_id") @db.Uuid
  /// 门店详细名称（如：海淀中关村一店）
  name            String   @map("name") @db.VarChar(100)
  /// 门店配送收货详细地址
  address         String   @db.VarChar(200)
  /// 门店现场联系人
  contactPerson   String   @map("contact_person") @db.VarChar(50)
  /// 门店联系电话
  contactPhone    String   @map("contact_phone") @db.VarChar(20)
  /// 配送时段：MORNING(早) / NOON(中) / EVENING(晚)
  deliveryPeriod  String?  @map("delivery_period") @db.VarChar(50)
  /// 默认配送路线编码
  defaultRoute    String?  @map("default_route") @db.VarChar(50)
  /// 默认配送司机名称或工号
  defaultDriver   String?  @map("default_driver") @db.VarChar(50)
  /// 门店标签摘要（如 VIP门店、商圈旗舰）
  storeTags       String?  @map("store_tags") @db.VarChar(200)
  /// 所属区域编码（必填，用于区域报价匹配与物流调度）
  regionCode      String   @map("region_code") @db.VarChar(50)
  /// 结款财务联系人（门店现场收货人≠结款人时使用）
  billingContact  String?  @map("billing_contact") @db.VarChar(50)
  /// 结款财务联系人电话
  billingPhone    String?  @map("billing_phone") @db.VarChar(20)
  /// 门店状态：ACTIVE(正常) / DISABLED(停用)
  status          String   @default("ACTIVE") @db.VarChar(10)
  /// 创建人用户ID
  createdById     String   @map("created_by_id") @db.Uuid
  /// 归属部门ID
  deptId          String?  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID
  updatedById     String?  @map("updated_by_id") @db.Uuid
  /// 软删除标记
  isDeleted       Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById     String?  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt       DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime @updatedAt @map("updated_at")

  /// 所属客户
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 针对该门店的独立报价单列表
  quotes          CustomerQuote[]

  @@index([customerId])
  @@index([regionCode])
  @@index([status])
  @@index([isDeleted])
  @@map("customer_store")
}

/// 客户标签字典表：用于筛选、统计、报价与配送策略
model CustomerTag {
  /// 标签主键ID (UUIDv7)
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 标签名称（如：早间配送、VIP客户、学校食堂）
  name        String   @map("name") @db.VarChar(50)
  /// 业务标签类型ID：关联基础档案 tenant_dict_item 的主键 id
  tagTypeId   String?  @map("tag_type_id") @db.Uuid
  /// 标签业务说明
  description String?  @db.VarChar(200)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status      String   @default("ACTIVE") @db.VarChar(10)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId      String?  @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById String?  @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt   DateTime? @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById String?  @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 关联的客户标签记录
  assignments CustomerTagAssignment[]

  @@index([tagTypeId])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("customer_tag")
}

/// 客户与标签多对多关联表
model CustomerTagAssignment {
  /// 客户主键ID
  customerId String   @map("customer_id") @db.Uuid
  /// 标签主键ID
  tagId      String   @map("tag_id") @db.Uuid
  /// 关联打标时间
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_assignment")
}

/// 部门拓扑模型 (用于数据范围 DEPT / DEPT_TREE 判定)
model Department {
  /// 部门主键ID (UUIDv7)
  id             String   @id @default(uuid(7)) @db.Uuid
  /// 部门名称
  name           String
  /// 部门业务编码
  code           String   @unique
  /// 父级部门ID (支持树状拓扑)
  parentId       String?  @map("parent_id") @db.Uuid
  /// 部门分管领导/主管成员ID (关联平台 Member.id)
  leaderMemberId String?  @map("leader_member_id")
  /// 显示排序权重 (数字越小越靠前)
  sort           Int      @default(0)
  /// 部门状态: ACTIVE(正常) / DISABLED(停用)
  status         String   @default("ACTIVE")
  /// 创建时间
  createdAt      DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime @updatedAt @map("updated_at")

  employees      EmployeeProfile[]

  @@index([parentId])
  @@index([status])
  @@map("department")
}

/// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  /// 员工档案主键ID
  id                String           @id @default(uuid(7)) @db.Uuid
  /// 关联平台租户成员主键 (Control DB Member.id)
  memberId          String?          @unique @map("member_id")
  /// 关联平台用户账号ID (Control DB User.id)
  userId            String?          @map("user_id")
  /// 邀请记录ID (关联邀请审核流)
  invitationId      String?          @map("invitation_id")
  /// 员工工号 (企业内部唯一)
  employeeNo        String?          @unique @map("employee_no")
  /// 所属部门主键ID
  departmentId      String?          @map("department_id") @db.Uuid
  /// 所属岗位主键ID
  positionId        String?          @map("position_id") @db.Uuid
  /// 直属上级经理档案ID
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  /// 员工姓名
  name              String           @default("") @map("name")
  /// 员工工作邮箱
  email             String           @default("") @map("email")
  /// 员工手机号
  phone             String?          @map("phone")
  /// 职务头衔/对外称谓
  jobTitle          String?          @map("job_title")
  /// 员工头像/工牌照 URL
  avatarUrl         String?          @map("avatar_url")
  /// 员工在职状态: ACTIVE(在职) / TERMINATED(离职) / SUSPENDED(停职)
  status            String           @default("ACTIVE")
  /// 入职报到时间
  joinedAt          DateTime?        @map("joined_at")
  /// 离职归档时间
  terminatedAt      DateTime?        @map("terminated_at")
  /// 档案创建时间
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 档案最后更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at")

  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  manager           EmployeeProfile? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subordinates      EmployeeProfile[] @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([memberId])
  @@index([status])
  @@map("employee_profile")
}

/// 工序主档表
model Operation {
  /// 主键ID (UUIDv7)
  id                          String                    @id @default(uuid(7)) @db.Uuid
  /// 工序编码 (全表唯一)
  code                        String                    @unique @map("code") @db.VarChar(64)
  /// 工序名称
  name                        String                    @map("name") @db.VarChar(128)
  /// 工序分类字典项ID (OPERATION_CATEGORY)
  operationCategoryDictItemId String                    @map("operation_category_dict_item_id") @db.Uuid
  /// 默认准备时间 (分钟)
  defaultSetupMinutes         Int                       @default(0) @map("default_setup_minutes")
  /// 默认清理时间 (分钟)
  defaultCleanupMinutes       Int                       @default(0) @map("default_cleanup_minutes")
  /// 默认参考出成率 (不直接参与发布BOM计算)
  defaultYieldRate            Decimal?                  @map("default_yield_rate") @db.Decimal(12, 8)
  /// 最少操作人数
  minimumOperatorCount        Int?                      @map("minimum_operator_count")
  /// 工序默认最小批量
  minimumBatchQuantity        Decimal?                  @map("minimum_batch_quantity") @db.Decimal(20, 6)
  /// 最小批量单位ID (关联 UnitOfMeasure.id)
  minimumBatchUnitId          String?                   @map("minimum_batch_unit_id") @db.Uuid
  /// 默认 SOP 操作说明
  sopText                     String?                   @map("sop_text") @db.Text
  /// 状态: ACTIVE / DISABLED
  status                      String                    @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById                 String                    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId                      String?                   @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById                 String?                   @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted                   Boolean                   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt                   DateTime?                 @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById                 String?                   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt                   DateTime                  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt                   DateTime                  @updatedAt @map("updated_at")

  specifications              ProcessingSpecification[]
  lineOperations              ProductionLineOperation[]
  bomVersionOperations        BomVersionOperation[]

  @@index([operationCategoryDictItemId, status])
  @@index([status])
  @@map("operation")
}

/// 岗位模型 (实现 Position != Role 物理正交解耦)
model Position {
  /// 岗位主键ID
  id          String            @id @default(uuid(7)) @db.Uuid
  /// 岗位名称
  name        String
  /// 岗位业务编码
  code        String            @unique
  /// 岗位职责详细描述
  description String?
  /// 排序权重 (数字越小越靠前)
  sort        Int               @default(0)
  /// 岗位状态: ACTIVE(正常) / DISABLED(停用)
  status      String            @default("ACTIVE")
  /// 创建时间
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime          @updatedAt @map("updated_at")

  employees   EmployeeProfile[]

  @@index([status])
  @@map("position")
}

/// 加工规格表
model ProcessingSpecification {
  /// 主键ID (UUIDv7)
  id                   String                @id @default(uuid(7)) @db.Uuid
  /// 所属工序ID
  operationId          String                @map("operation_id") @db.Uuid
  /// 工序内规格编码 (如 CUT_SLICE_3MM)
  code                 String                @map("code") @db.VarChar(64)
  /// 规格名称 (如 切丝5mm、切片3mm)
  name                 String                @map("name") @db.VarChar(128)
  /// 加工说明
  description          String?               @map("description") @db.Text
  /// 默认参考出成率
  defaultYieldRate     Decimal?              @map("default_yield_rate") @db.Decimal(12, 8)
  /// 状态: ACTIVE / DISABLED
  status               String                @default("ACTIVE") @map("status") @db.VarChar(16)

  // ===== 框架强制基础审计与数据范围基线字段 (ADR-009) =====
  /// 创建人用户ID (UUIDv7)
  createdById          String                @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门ID (UUIDv7)
  deptId               String?               @map("dept_id") @db.Uuid
  /// 最后更新人用户ID (UUIDv7)
  updatedById          String?               @map("updated_by_id") @db.Uuid
  /// 软删除标记 (默认 false)
  isDeleted            Boolean               @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt            DateTime?             @map("deleted_at")
  /// 软删除操作人用户ID (UUIDv7)
  deletedById          String?               @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt            DateTime              @default(now()) @map("created_at")
  /// 更新时间
  updatedAt            DateTime              @updatedAt @map("updated_at")

  operation            Operation             @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bomVersionOperations BomVersionOperation[]

  @@unique([operationId, code])
  @@index([operationId, status])
  @@index([status])
  @@map("processing_specification")
}

/// 统一商品物料主档表 (原料、半成品、成品、包材共用)
model Product {
  /// 主键ID (UUIDv7)
  id                        String            @id @default(uuid(7)) @db.Uuid
  /// 商品编码 (全表唯一)
  code                      String            @unique @map("code") @db.VarChar(64)
  /// 商品名称
  name                      String            @map("name") @db.VarChar(128)
  /// 搜索别名/助记码
  alias                     String?           @map("alias") @db.VarChar(256)
  /// 所属商品品类ID
  productCategoryId         String            @map("product_category_id") @db.Uuid
