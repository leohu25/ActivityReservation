  deletedById String?   @map("deleted_by_id") @db.Uuid
  /// 创建时间
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, isDeleted, status, sort])
  @@index([status])
  @@map("tenant_dict_item")
}

/// 租户动态导航菜单配置模型 (支持现场层级调整、自定义别名与跨切片灵活编排)
model TenantMenuItem {
  /// 节点主键ID
  id           String    @id @default(uuid(7)) @db.Uuid
  /// 父节点ID (空表示顶级大菜单/顶级单页)
  parentId     String?   @map("parent_id") @db.Uuid
  /// 节点类型: GROUP(大菜单/目录分组) | PAGE(具体功能页面) | LINK(外部链接)
  itemType     String    @default("PAGE") @map("item_type")
  /// 关联的标准页面键名 (若 itemType="PAGE"，对应 StandardPageDescriptor.pageKey)
  pageKey      String?   @map("page_key")
  /// 外部跳转 URL (若 itemType="LINK"，如 "https://bi.company.com")
  externalUrl  String?   @map("external_url")
  /// 是否在新标签页打开
  openInNewTab Boolean   @default(false) @map("open_in_new_tab")
  /// 自定义显示别名 (现场实施重命名；空则使用页面契约 defaultLabel)
  customLabel  String?   @map("custom_label")
  /// 自定义图标名称 (空则使用页面契约 defaultIcon)
  customIcon   String?   @map("custom_icon")
  /// 排序权重 (升序排列)
  sortOrder    Int       @default(0) @map("sort_order")
  /// 是否可见
  isVisible    Boolean   @default(true) @map("is_visible")

  /// 创建人 ID (UUIDv7，系统写入为 SYSTEM_ACTOR_ID)
  createdById  String    @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  /// 归属部门 ID (UUIDv7)
  deptId       String?   @map("dept_id") @db.Uuid
  /// 更新人 ID (UUIDv7)
  updatedById  String?   @map("updated_by_id") @db.Uuid
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// 软删除标记
  isDeleted    Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt    DateTime? @map("deleted_at")
  /// 软删除人 ID (UUIDv7)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  @@index([parentId, sortOrder])
  @@index([isDeleted])
  @@map("tenant_menu_item")
}

/// 计量单位表
model UnitOfMeasure {
  /// 主键ID (UUIDv7)
  id                  String    @id @default(uuid(7)) @db.Uuid
  /// 单位编码 (如 KG, G, PCS 等，唯一)
  code                String    @unique @map("code") @db.VarChar(32)
  /// 单位显示名称 (如 千克, 克, 个 等)
  name                String    @map("name") @db.VarChar(64)
