  updatedAt   DateTime @updatedAt @map("updated_at")

  spaces      Space[]
  activities  Activity[]
  news        News[]

  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("venue")
}

model VolunteerApplication {
  id          String   @id @default(uuid(7)) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(50)
  studentNo   String?  @map("student_no") @db.VarChar(50)
  major       String?  @db.VarChar(100)
  serviceRole String?  @map("service_role") @db.VarChar(50)
  status      String   @default("PENDING") @db.VarChar(20)
  auditRemark String?  @map("audit_remark") @db.VarChar(255)

  createdById String   @default("00000000-0000-7000-8000-000000000000") @map("created_by_id") @db.Uuid
  deptId      String?  @map("dept_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?  @map("deleted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity    Activity @relation(fields: [activityId], references: [id])

  @@index([activityId])
  @@index([phone])
  @@index([status])
  @@index([deptId])
  @@index([isDeleted])
  @@map("volunteer_application")
}
