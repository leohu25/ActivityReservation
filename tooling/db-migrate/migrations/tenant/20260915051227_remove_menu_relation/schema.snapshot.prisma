// Generated canonical schema. Do not edit directly.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


/// 工艺 BOM 表头
model BomHeader {
  /// BOM主键ID
  id                 String    @id @default(cuid())
  /// BOM唯一编号
  bomCode            String    @unique @map("bom_code") @db.VarChar(50)
  /// BOM名称
  bomName            String    @map("bom_name") @db.VarChar(100)
  /// BOM类型: SINGLE(单品) / COMPOSITE(组合) / PACKAGING(包装)
  bomType            String    @map("bom_type") @db.VarChar(20)
  /// 版本号（如 V1.0, V1.1）
  version            String    @default("V1.0") @db.VarChar(20)
  /// 是否研发BOM
  isResearch         Boolean   @default(false) @map("is_research")
  /// 是否产出商品的默认生效BOM
  isDefault          Boolean   @default(true) @map("is_default")
  
  /// 产出目标物料编码
  outputItemCode     String    @map("output_item_code") @db.VarChar(50)
  /// 基准批量数量
  batchQty           Decimal   @default(1) @map("batch_qty") @db.Decimal(12, 3)
  /// 基准批量单位
  batchUnit          String    @map("batch_unit") @db.VarChar(20)
  
  /// 绑定的车间产线ID
  productionLineId   String?   @map("production_line_id") @db.VarChar(50)
  /// 关联默认工艺路线编码
  routeCode          String?   @map("route_code") @db.VarChar(50)
  /// 是否强行覆盖为总出成率
  overrideTotalYield Boolean   @default(false) @map("override_total_yield")
  /// 设定的总出成率(%)
  totalYieldRate     Decimal?  @map("total_yield_rate") @db.Decimal(5, 2)
  
  /// 状态: DRAFT(草稿) / UNDER_REVIEW(评审中) / ACTIVE(已发布生效) / ARCHIVED(已归档)
  status             String    @default("DRAFT") @db.VarChar(20)
  /// 生效日期
  effectiveDate      DateTime  @default(now()) @map("effective_date")
  /// 备注信息
  remark             String?   @db.VarChar(200)

  // ===== 框架强制基础审计基线 (ADR-009) =====
  /// 创建人用户ID
  createdById        String    @map("created_by_id") @db.VarChar(50)
  /// 归属部门ID
  deptId             String?   @map("dept_id") @db.VarChar(50)
  /// 最后更新人用户ID
  updatedById        String?   @map("updated_by_id") @db.VarChar(50)
  /// 软删除标记
  isDeleted          Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt          DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById        String?   @map("deleted_by_id") @db.VarChar(50)
  /// 创建时间
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime  @updatedAt @map("updated_at")

  outputItem         ItemMaster      @relation("BomOutputItem", fields: [outputItemCode], references: [itemCode])
  productionLine     ProductionLine? @relation(fields: [productionLineId], references: [id])
  processes          BomProcess[]

  @@index([outputItemCode, bomType, status])
  @@index([createdById])
  @@index([isDeleted])
  @@map("bom_header")
}

/// BOM 投入物料明细（工序级联）
model BomInputItem {
  /// 投入明细ID
  id             String     @id @default(cuid())
  /// 所属工序明细ID
  bomProcessId   String     @map("bom_process_id") @db.VarChar(50)
  /// 投入物料编码
  itemCode       String     @map("item_code") @db.VarChar(50)
  /// 投入基准数量
  quantity       Decimal    @db.Decimal(12, 3)
  /// 投入单位
  uom            String     @db.VarChar(20)
  /// 物料角色: FLOW(流转品) / SUB_BOM(外部子件-递归展开) / PURCHASE(外购件-直接采购)
  materialRole   String     @map("material_role") @db.VarChar(20)
  /// 投入占比(%)，组合BOM专用
  proportion     Decimal?   @db.Decimal(5, 2)
  /// 来源前序工序seq_no（流转品专用）
  prevProcessSeq Int?       @map("prev_process_seq")
  /// 外部子件挂载的子BOM编号
  childBomId     String?    @map("child_bom_id") @db.VarChar(50)

  bomProcess     BomProcess @relation(fields: [bomProcessId], references: [id], onDelete: Cascade)

  @@index([bomProcessId])
  @@map("bom_input_item")
}

/// MRP 运行时排产策略临时覆盖
model BomMrpOverride {
  /// 覆盖记录主键ID
  id             String    @id @default(cuid())
  /// MRP排产计划编号
  planId         String    @map("plan_id") @db.VarChar(50)
  /// 原BOM编号
  bomId          String    @map("bom_id") @db.VarChar(50)
  /// 覆盖的投入行ID
  inputItemId    String    @map("input_item_id") @db.VarChar(50)
  /// 原策略（如 SUB_BOM）
  originalRole   String    @map("original_role") @db.VarChar(20)
  /// 临时新策略（如 PURCHASE）
  newRole        String    @map("new_role") @db.VarChar(20)
  /// 修改原因说明
  reason         String?   @db.VarChar(200)

  // ===== 框架强制基础审计基线 (ADR-009) =====
  /// 创建人用户ID
  createdById    String    @map("created_by_id") @db.VarChar(50)
  /// 归属部门ID
  deptId         String?   @map("dept_id") @db.VarChar(50)
  /// 最后更新人用户ID
  updatedById    String?   @map("updated_by_id") @db.VarChar(50)
  /// 软删除标记
  isDeleted      Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt      DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById    String?   @map("deleted_by_id") @db.VarChar(50)
  /// 创建时间
  createdAt      DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([planId, bomId])
  @@index([createdById])
  @@index([isDeleted])
  @@map("bom_mrp_override")
}

/// BOM 产出物料明细（工序级联）
model BomOutputItem {
  /// 产出明细ID
  id             String     @id @default(cuid())
  /// 所属工序明细ID
  bomProcessId   String     @map("bom_process_id") @db.VarChar(50)
  /// 产出物料编码
  itemCode       String     @map("item_code") @db.VarChar(50)
  /// 产出数量
  quantity       Decimal    @db.Decimal(12, 3)
  /// 产出单位
  uom            String     @db.VarChar(20)
  /// 产出类型: MAIN(主产出) / BYPRODUCT(副产出/边角料) / SCRAP(废料)
  outputType     String     @map("output_type") @db.VarChar(20)
  /// 物料角色: FLOW(流转品) / FINAL(最终交付品)
  materialRole   String     @map("material_role") @db.VarChar(20)
  /// 下游流转工序seq_no（留空代表最终品）
  nextProcessSeq Int?       @map("next_process_seq")

  bomProcess     BomProcess @relation(fields: [bomProcessId], references: [id], onDelete: Cascade)

  @@index([bomProcessId])
  @@map("bom_output_item")
}

/// BOM 工序节点明细（主表级联）
model BomProcess {
  /// 工序明细ID
  id                    String    @id @default(cuid())
  /// 所属BOM ID
  bomId                 String    @map("bom_id") @db.VarChar(50)
  /// 工序顺序号 (10, 20, 30...)
  seqNo                 Int       @map("seq_no")
  /// 关联工序ID
  processId             String    @map("process_id") @db.VarChar(50)
  /// 关联加工规格ID
  specId                String?   @map("spec_id") @db.VarChar(50)
  
  /// 本工序损耗率(%)
  lossRate              Decimal   @map("loss_rate") @db.Decimal(5, 2)
  /// 本工序出成率(%) = 100 - lossRate
  yieldRate             Decimal   @map("yield_rate") @db.Decimal(5, 2)
  /// 标准工时(小时)
  stdLaborHours         Decimal?  @map("std_labor_hours") @db.Decimal(8, 3)
  /// 是否质检节点
  qcCheckpoint          Boolean   @default(false) @map("qc_checkpoint")
  
  /// 工序运行指导参数快照JSON
  instructionParams     Json?     @map("instruction_params")
  /// 工序操作图文说明
  operatingInstructions String?   @map("operating_instructions") @db.Text

  bom                   BomHeader      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  process               ProcessMaster  @relation(fields: [processId], references: [id])
  spec                  ProcessSpec?   @relation(fields: [specId], references: [id])
  inputs                BomInputItem[]
  outputs               BomOutputItem[]

  @@index([bomId, seqNo])
  @@map("bom_process")
}

/// 租户企业扩展资料模型 (与平台 Organization 动静分离)
model CompanyProfile {
  /// 企业扩展资料主键ID
  id           String   @id @default(cuid())
  /// 企业主体注册全称
  companyName  String   @map("company_name")
  /// 企业简称/品牌名
  shortName    String?  @map("short_name")
  /// 统一社会信用代码
  creditCode   String?  @map("credit_code")
  /// 法定代表人姓名
  legalPerson  String?  @map("legal_person")
  /// 官方业务联系电话
  contactPhone String?  @map("contact_phone")
  /// 官方业务联系邮箱
  contactEmail String?  @map("contact_email")
  /// 经营办公/注册地址
  address      String?
  /// 业务时区 (默认 Asia/Shanghai)
  timezone     String   @default("Asia/Shanghai")
  /// 结算本位币种 (默认 CNY)
  currency     String   @default("CNY")
  /// 记录创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 记录更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

/// 客户档案主表：维护企业级客户的基本信息与结算主数据
model Customer {
  /// 客户全局唯一编码（系统自增生成，格式 CUST-YYYYMMDD-XXXX）
  customerCode     String   @id @map("customer_code") @db.VarChar(30)
  /// 客户企业名称
  customerName     String   @map("customer_name") @db.VarChar(100)
  /// 所属客户分类编码
  categoryCode     String   @map("category_code") @db.VarChar(20)
  /// 核心联系人姓名
  contactPerson    String   @map("contact_person") @db.VarChar(50)
  /// 联系电话
  contactPhone     String   @map("contact_phone") @db.VarChar(20)
  /// 结算方式：MONTHLY(月结) / CASH(现结) / PREPAID(预付)
  settlementMethod String   @map("settlement_method") @db.VarChar(20)
  /// 默认税率(%)，如 9.00 表示 9%
  defaultTaxRate   Decimal? @map("default_tax_rate") @db.Decimal(5, 2)
  /// 授信信用额度(元)
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(12, 2)
  /// 客户标签摘要缓存（冗余字段，方便快速搜索展示）
  customerTags     String?  @map("customer_tags") @db.VarChar(200)
  /// 负责销售经理 / 业务员姓名或工号
  salesPerson      String?  @map("sales_person") @db.VarChar(50)
  /// 默认发货仓库标识
  defaultWarehouse String?  @map("default_warehouse") @db.VarChar(50)
  /// 付款周期：WEEKLY(周结) / BIWEEKLY(半月结) / MONTHLY(月结)
  paymentCycle     String?  @map("payment_cycle") @db.VarChar(20)
  /// 服务收货时间窗口（如：早8:00-10:00）
  serviceTime      String?  @map("service_time") @db.VarChar(50)
  /// 最近下单履约时间（系统只读自动更新）
  lastOrderTime    DateTime? @map("last_order_time")
  /// 客户状态：ACTIVE(正常) / DISABLED(停用)
  status           String   @default("ACTIVE") @db.VarChar(10)
  /// 创建人用户ID
  createdById      String   @map("created_by_id") @db.VarChar(50)
  /// 归属部门ID (用于数据范围判定)
  deptId           String?  @map("dept_id") @db.VarChar(50)
  /// 最后更新人用户ID
  updatedById      String?  @map("updated_by_id") @db.VarChar(50)
  /// 软删除标记
  isDeleted        Boolean  @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt        DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById      String?  @map("deleted_by_id") @db.VarChar(50)
  /// 创建时间
  createdAt        DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// 所属分类关联
  category         CustomerCategory @relation(fields: [categoryCode], references: [categoryCode], onDelete: Restrict)
  /// 客户关联的多标签记录
  tagAssignments   CustomerTagAssignment[]
  /// 该客户下属的多个门店列表
  stores           CustomerStore[]
  /// 针对该客户的专属报价单列表
  quotes           CustomerQuote[]

  @@index([categoryCode])
  @@index([status])
  @@map("customer")
}

/// 客户分类表：支持多级层级树结构（如餐饮连锁、企事业单位、生鲜超市）
model CustomerCategory {
  /// 分类编码（唯一主键标识，如 CUST_CAT_001）
  categoryCode String   @id @map("category_code") @db.VarChar(20)
  /// 分类名称（如：机关食堂、品牌连锁）
  categoryName String   @map("category_name") @db.VarChar(50)
  /// 父级分类编码（支持多级分类树，根级为空）
  parentCode   String?  @map("parent_code") @db.VarChar(20)
  /// 分类业务描述
  description  String?  @db.VarChar(200)
  /// 状态：ACTIVE(启用) / DISABLED(停用)
  status       String   @default("ACTIVE") @db.VarChar(10)
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// 自引用：父级分类
  parent       CustomerCategory?  @relation("CategoryHierarchy", fields: [parentCode], references: [categoryCode], onDelete: Restrict)
  /// 自引用：子级分类列表
  children     CustomerCategory[] @relation("CategoryHierarchy")
  /// 该分类下的客户档案列表
  customers    Customer[]

  @@map("customer_category")
}

/// 门店报价单主表：按客户+门店+区域维护的商品定价单头
model CustomerQuote {
  /// 报价单唯一单号（系统自动生成，格式 QUOT-YYYYMMDD-XXXX）
  quoteId         String    @id @map("quote_id") @db.VarChar(30)
  /// 适用客户编码（与 storeCode、regionCode 构成维度优先级）
  customerCode    String?   @map("customer_code") @db.VarChar(30)
  /// 适用门店编码（为空则适用于该客户下属所有门店）
  storeCode       String?   @map("store_code") @db.VarChar(30)
  /// 适用区域编码（客户与门店均为空时，作为该区域通用报价单）
  regionCode      String?   @map("region_code") @db.VarChar(50)
  /// 报价单拟定日期
  quoteDate       DateTime  @map("quote_date") @db.Date
  /// 价格生效日期
  effectiveDate   DateTime  @map("effective_date") @db.Date
  /// 价格失效日期（为空表示长期有效）
  expiryDate      DateTime? @map("expiry_date") @db.Date
  /// 报价单类型：STANDARD(普通报价单) / CYCLE(周期报价单)
  quoteType       String    @default("STANDARD") @map("quote_type") @db.VarChar(20)
  /// 对外展示简称（供客户查看核对的报价单名称）
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// 包含的商品明细条目总数（系统自动汇总）
  itemCount       Int       @default(0) @map("item_count")
  /// 关联客户总数（只读统计）
  customerCount   Int       @default(0) @map("customer_count")
  /// 单据状态：DRAFT(草稿) / ACTIVE(已生效) / EXPIRED(已过期) / VOIDED(已作废)
  status          String    @default("DRAFT") @db.VarChar(10)
  /// 创建人姓名或工号
  createdBy       String    @map("created_by") @db.VarChar(50)
  /// 创建人用户ID
  createdById     String    @map("created_by_id") @db.VarChar(50)
  /// 归属部门ID
  deptId          String?   @map("dept_id") @db.VarChar(50)
  /// 最后更新人用户ID
  updatedById     String?   @map("updated_by_id") @db.VarChar(50)
  /// 软删除标记
  isDeleted       Boolean   @default(false) @map("is_deleted")
  /// 软删除时间
  deletedAt       DateTime? @map("deleted_at")
  /// 软删除操作人用户ID
  deletedById     String?   @map("deleted_by_id") @db.VarChar(50)
  /// 创建时间
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// 关联客户档案
  customer        Customer?      @relation(fields: [customerCode], references: [customerCode], onDelete: Restrict)
  /// 关联门店档案
  store           CustomerStore? @relation(fields: [storeCode], references: [storeCode], onDelete: Restrict)
  /// 报价单包含的商品明细列表
  items           CustomerQuoteItem[]

  @@index([customerCode])
  @@index([storeCode])
  @@index([regionCode])
  @@index([status])
  @@map("customer_quote")
}

/// 门店报价单明细表：具体商品的含税与不含税单价及起订限制
model CustomerQuoteItem {
  /// 报价明细行主键唯一标识
  quoteDetailId     String   @id @map("quote_detail_id") @db.VarChar(50)
  /// 所属报价单单号
  quoteId           String   @map("quote_id") @db.VarChar(30)
  /// 商品档案唯一编码（关联物料商品中心）
  itemCode          String   @map("item_code") @db.VarChar(50)
  /// 商品名称（如：特级上海青(净菜)）
  itemName          String   @map("item_name") @db.VarChar(100)
  /// 销售计量单位（如：kg、箱、袋）
  salesUnit         String   @map("sales_unit") @db.VarChar(20)
  /// 不含税单价（元）
  unitPriceExclTax  Decimal  @map("unit_price_excl_tax") @db.Decimal(10, 2)
  /// 含税销售单价（元）
  unitPriceInclTax  Decimal  @map("unit_price_incl_tax") @db.Decimal(10, 2)
  /// 适用增值税税率(%)，如 9.00
  taxRate           Decimal  @map("tax_rate") @db.Decimal(5, 2)
  /// 最小起订量限制
  minQty            Decimal? @map("min_qty") @db.Decimal(10, 2)
  /// 最大限购量限制
  maxQty            Decimal? @map("max_qty") @db.Decimal(10, 2)
  /// 明细备注说明
  remark            String?  @db.VarChar(200)

  /// 所属报价单主表关联
  quote             CustomerQuote @relation(fields: [quoteId], references: [quoteId], onDelete: Cascade)

  @@index([quoteId])
  @@index([itemCode])
  @@map("customer_quote_item")
}

/// 门店档案主表：客户下属的履约单位（订单、配送、签收、对账最小主体）
model CustomerStore {
  /// 门店全局唯一编码（系统自动生成，格式 STOR-YYYYMMDD-XXXX）
  storeCode       String   @id @map("store_code") @db.VarChar(30)
  /// 所属客户编码（外键关联 Customer）
  customerCode    String   @map("customer_code") @db.VarChar(30)
  /// 门店详细名称（如：海淀中关村一店）
  storeName       String   @map("store_name") @db.VarChar(100)
  /// 门店配送收货详细地址
  address         String   @db.VarChar(200)
  /// 门店现场联系人
  contactPerson   String   @map("contact_person") @db.VarChar(50)
  /// 门店联系电话
  contactPhone    String   @map("contact_phone") @db.VarChar(20)
  /// 配送时段：MORNING(早) / NOON(中) / EVENING(晚)
  deliveryPeriod  String?  @map("delivery_period") @db.VarChar(50)
  /// 默认配送路线编码
  defaultRoute    String?  @map("default_route") @db.VarChar(50)
  /// 默认配送司机名称或工号
  defaultDriver   String?  @map("default_driver") @db.VarChar(50)
  /// 门店标签摘要（如 VIP门店、商圈旗舰）
  storeTags       String?  @map("store_tags") @db.VarChar(200)
  /// 所属区域编码（必填，用于区域报价匹配与物流调度）
  regionCode      String   @map("region_code") @db.VarChar(50)
  /// 结款财务联系人（门店现场收货人≠结款人时使用）
  billingContact  String?  @map("billing_contact") @db.VarChar(50)
  /// 结款财务联系人电话
  billingPhone    String?  @map("billing_phone") @db.VarChar(20)
  /// 门店状态：ACTIVE(正常) / DISABLED(停用)
  status          String   @default("ACTIVE") @db.VarChar(10)
  /// 创建人用户ID
  createdById     String   @map("created_by_id") @db.VarChar(50)
  /// 归属部门ID
  deptId          String?  @map("dept_id") @db.VarChar(50)
  /// 最后更新人用户ID
  updatedById     String?  @map("updated_by_id") @db.VarChar(50)
  /// 软删除标记
