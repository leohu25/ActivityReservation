/// 租户内员工档案模型 (对应 Control DB Member.id，组织人事与数据范围事实源)
model EmployeeProfile {
  /// 员工档案主键ID
  id                String           @id @default(cuid())
  /// 关联平台租户成员主键 (Control DB Member.id)
  memberId          String?          @unique @map("member_id")
  /// 关联平台用户账号ID (Control DB User.id)
  userId            String?          @map("user_id")
  /// 邀请记录ID (关联邀请审核流)
  invitationId      String?          @map("invitation_id")
  /// 员工工号 (企业内部唯一)
  employeeNo        String?          @unique @map("employee_no")
  /// 所属部门主键ID
  departmentId      String?          @map("department_id")
  /// 所属岗位主键ID
  positionId        String?          @map("position_id")
  /// 直属上级经理档案ID
  managerEmployeeId String?          @map("manager_employee_id")
  /// 员工姓名快照 (冗余展示与防变更穿透)
  nameSnapshot      String           @default("") @map("name_snapshot")
  /// 员工工作邮箱快照
  emailSnapshot     String           @default("") @map("email_snapshot")
  /// 职务头衔/对外称谓
  jobTitle          String?          @map("job_title")
  /// 员工在职状态: ACTIVE(在职) / TERMINATED(离职) / SUSPENDED(停职)
  status            String           @default("ACTIVE")
  /// 入职报到时间
  joinedAt          DateTime?        @map("joined_at")
  /// 离职归档时间
  terminatedAt      DateTime?        @map("terminated_at")
  /// 档案创建时间
  createdAt         DateTime         @default(now()) @map("created_at")
  /// 档案最后更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at")

  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position          Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager           EmployeeProfile? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  subordinates      EmployeeProfile[] @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([memberId])
  @@index([status])
  @@map("employee_profile")
}

