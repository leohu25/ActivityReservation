  itemType           String    @default("STANDARD") @map("item_type") @db.VarChar(20)
  /// 商品标签（逗号分隔）
  itemTags           String?   @map("item_tags") @db.VarChar(200)
  
  /// 基本单位（库存核算基准单位）
