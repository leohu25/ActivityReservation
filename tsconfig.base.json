{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@chenrun/shared": ["packages/shared/src/index.ts"],
      "@chenrun/auth": ["packages/auth/src/index.ts"],
      "@chenrun/authorization": ["packages/authorization/src/index.ts"],
      "@chenrun/db-control": ["packages/db-control/src/index.ts"],
      "@chenrun/db-tenant": ["packages/db-tenant/src/index.ts"],
      "@chenrun/ui": ["packages/ui/src/index.ts"],
      "@chenrun/feature-platform-admin": ["packages/features/platform-admin/src/index.ts"],
      "@chenrun/feature-platform-admin/*": ["packages/features/platform-admin/src/*"],
      "@chenrun/feature-procurement-center": ["packages/features/procurement-center/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
