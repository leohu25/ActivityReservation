{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "globalDependencies": ["turbo.json", "pnpm-workspace.yaml"],
  "tasks": {
    "codegen": {
      "cache": true
    },
    "@runtime/db#codegen": {
      "inputs": [
        "scripts/**",
        "../../packages/base/db-tenant/prisma/schema.prisma",
        "../../packages/domains/**/prisma/schema.prisma",
        "../../packages/platform/**/prisma/schema.prisma"
      ],
      "outputs": ["prisma/schema.prisma"]
    },
    "tenant#codegen": {
      "inputs": [
        "scripts/**",
        "../../packages/domains/**/src/manifest.ts",
        "../../packages/platform/**/src/manifest.ts",
        "../../packages/domains/**/package.json",
        "../../packages/platform/**/package.json"
      ],
      "outputs": ["src/assembly/registry.generated.ts"]
    },
    "generate": {
      "dependsOn": ["@runtime/db#codegen", "tenant#codegen", "^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".env.local"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["generate", "^check"],
      "cache": false
    },
    "test": {
      "dependsOn": ["generate", "^test"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}
