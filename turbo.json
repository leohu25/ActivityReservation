{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "tasks": {
    "//#codegen": {
      "inputs": [
        "packages/features/**/src/manifest.ts",
        "packages/features/**/prisma/schema.prisma",
        "packages/features/**/package.json",
        "packages/db-tenant/prisma/schema.prisma",
        "scripts/sync/**"
      ],
      "outputs": [
        "apps/tenant/src/kernel/registry.generated.ts",
        "packages/db-tenant/prisma/schema.generated.prisma"
      ]
    },
    "build": {
      "dependsOn": ["//#codegen", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".env.local"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check": {
      "dependsOn": ["//#codegen", "^check"],
      "cache": false
    },
    "test": {
      "dependsOn": ["//#codegen", "^test"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["//#codegen"],
      "cache": false,
      "persistent": true
    }
  }
}
