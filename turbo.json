{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "tasks": {
    "//#codegen": {
      "inputs": [
        "packages/platform/**/src/manifest.ts",
        "packages/domains/**/src/manifest.ts",
        "packages/domains/**/prisma/schema.prisma",
        "packages/platform/**/package.json",
        "packages/domains/**/package.json",
        "packages/base/db-tenant/prisma/schema.prisma",
        "scripts/sync/**"
      ],
      "outputs": [
        "packages/runtime/tenant/src/registry.ts",
        "packages/runtime/db/prisma/schema.prisma"
      ]
    },
    "generate": {
      "dependsOn": ["//#codegen"],
      "cache": false
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".env.local"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["generate", "^check"],
      "cache": false
    },
    "test": {
      "dependsOn": ["generate", "^test"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}
